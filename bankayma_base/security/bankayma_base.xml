<odoo>
    <record id="category" model="ir.module.category">
        <!--
    add module category to use it for groups, this groups them
    together on the user config screen
    -->
        <field name="name">Bankayma</field>
    </record>

    <record id="group_user" model="res.groups">
        <!--
    define an own user group for users of child companies, that
    simplifies dumbing down the UI only for them but have full
    functionality for the users of the main company
    -->
        <field name="name">Project User</field>
        <field name="category_id" ref="category" />
        <field name="comment" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_manager" model="res.groups">
        <!--
    as project managers also should get a simplified UI, we make them
    their own group too
    -->
        <field name="name">Project Manager</field>
        <field name="category_id" ref="category" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_user')), Command.link(ref('base.group_partner_manager'))]"
        />
    </record>

    <record id="group_org_manager" model="res.groups">
        <field name="name">Organization Manager</field>
        <field name="category_id" ref="category" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_user')), Command.link(ref('base.group_partner_manager')), Command.link(ref('mass_mailing.group_mass_mailing_user')), Command.link(ref('mail.group_mail_template_editor'))]"
        />
    </record>

    <record id="group_future" model="res.groups">
        <field name="name">Future features</field>
        <field name="category_id" ref="category" />
    </record>

    <record id="group_full" model="res.groups">
        <field name="name">Full Odoo functionality</field>
        <field name="category_id" ref="category" />
    </record>

    <record id="group_vendor" model="res.groups">
        <field name="name">Vendor</field>
        <field name="category_id" ref="base_portal_type.category_portal_type" />
    </record>

    <record id="base.group_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('operating_unit.group_multi_operating_unit')), Command.unlink(ref('mail.group_mail_template_editor'))]"
        />
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[Command.link(ref('group_full'))]" />
    </record>

    <record id="rule_blog_post" model="ir.rule">
        <field name="name">Restrict editing blog posts by OU</field>
        <field name="model_id" ref="website_blog.model_blog_post" />
        <field name="domain_force">
            [('operating_unit_id', 'in', operating_unit_ids)]
        </field>
        <field name="perm_create" eval="True" />
        <field name="perm_read" eval="False" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="groups" eval="[Command.link(ref('bankayma_base.group_user'))]" />
    </record>

    <record id="rule_event_event" model="ir.rule">
        <field name="name">Restrict editing events by OU</field>
        <field name="model_id" ref="event.model_event_event" />
        <field name="domain_force">
            [('operating_unit_id', 'in', operating_unit_ids)]
        </field>
        <field name="perm_create" eval="True" />
        <field name="perm_read" eval="False" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="groups" eval="[Command.link(ref('bankayma_base.group_user'))]" />
    </record>

    <record id="rule_product_product" model="ir.rule">
        <field name="name">Restrict editing products by OU</field>
        <field name="model_id" ref="product.model_product_product" />
        <field name="domain_force">
            [('operating_unit_id', 'in', operating_unit_ids)]
        </field>
        <field name="perm_create" eval="True" />
        <field name="perm_read" eval="False" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="groups" eval="[Command.link(ref('bankayma_base.group_user'))]" />
    </record>

    <record id="rule_product_template" model="ir.rule">
        <field name="name">
            Restrict editing product templates by OU
        </field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="domain_force">
            [('operating_unit_id', 'in', operating_unit_ids)]
        </field>
        <field name="perm_create" eval="True" />
        <field name="perm_read" eval="False" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="groups" eval="[Command.link(ref('bankayma_base.group_user'))]" />
    </record>
</odoo>
