<odoo>
    <record id="view_res_company_category_form" model="ir.ui.view">
        <field
            name="inherit_id"
            ref="res_company_category.view_res_company_category_form"
        />
        <field name="model">res.company.category</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']/../.." position="after">
                <group>
                    <group name="bankayma_company_flags" string="Company properties">
                        <field name="show_in_company_selector" />
                    </group>
                    <group
                        name="bankayma_category_flags"
                        string="Category properties"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
