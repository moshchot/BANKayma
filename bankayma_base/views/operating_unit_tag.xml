<odoo>
   <record id="view_operating_unit_tag_list" model="ir.ui.view">
        <field name="model">operating.unit.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="parent_id" />
            </list>
        </field>
    </record>
    <record id="view_operating_unit_tag_form" model="ir.ui.view">
        <field name="model">operating.unit.tag</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="name" />
                    <field name="parent_id" />
                </group>
            </form>
        </field>
    </record>
    <record id="view_operating_unit_tag_search" model="ir.ui.view">
        <field name="model">operating.unit.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="parent_id" />
            </search>
        </field>
    </record>
    <record id="action_operating_unit_tag" model="ir.actions.act_window">
        <field name="name">Operating Unit Tags</field>
        <field name="res_model">operating.unit.tag</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_operating_unit_tag"
        action="action_operating_unit_tag"
        parent="base.menu_users"
    />
</odoo>
