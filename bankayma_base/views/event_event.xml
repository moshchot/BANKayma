<odoo>
    <record id="view_event_form" model="ir.ui.view">
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <field name="address_id" position="attributes">
                <attribute name="context" operation="update">
                    {
                        'form_view_ref': 'bankayma_base.bankayma_partner_venue_form',
                        'default_country_id': %(base.il)s,
                        'default_city': 'Jerusalem',
                    }
                </attribute>
                <attribute name="open_target">new</attribute>
            </field>
            <xpath
                expr="//group[@name='right_event_details']//field[@name='company_id']"
                position="after"
            >
                <field
                    name="operating_unit_id"
                    groups="operating_unit.group_multi_operating_unit"
                />
            </xpath>
        </field>
    </record>
</odoo>
