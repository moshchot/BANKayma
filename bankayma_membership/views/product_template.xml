<odoo>
    <record id="membership_products_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="membership.membership_products_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="bankayma_website_sale_company_id" required="True" />
            </field>
            <field name="company_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <field name="property_account_income_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="groups">
                    bankayma_base.group_org_manager,bankayma_base.group_full
                </attribute>
            </field>
            <field name="taxes_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <xpath expr="//sheet/label" position="before">
                <div class="oe_button_box" name="button_box">
                    <field name="is_published" widget="website_redirect_button" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
