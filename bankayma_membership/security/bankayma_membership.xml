<odoo>
    <record id="group_community_manager" model="res.groups">
        <field name="name">Community Manager</field>
        <field name="category_id" ref="bankayma_base.category" />
        <field name="comment" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('bankayma_base.group_user')), Command.link(ref('base.group_partner_manager'))]"
        />
    </record>
    <record id="rule_product_product" model="ir.rule">
        <field name="name">Restrict editing products to own and children</field>
        <field name="model_id" ref="product.model_product_product" />
        <field name="domain_force">
            [('bankayma_website_sale_company_id', 'in', company_ids), ('membership', '=', True)]
        </field>
        <field name="perm_create" eval="True" />
        <field name="perm_read" eval="False" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="groups" eval="[Command.link(ref('group_community_manager'))]" />
    </record>

    <record id="rule_product_template" model="ir.rule">
        <field name="name">
            Restrict editing product templates to own and children
        </field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="domain_force">
            [('bankayma_website_sale_company_id', 'in', company_ids), ('membership', '=', True)]
        </field>
        <field name="perm_create" eval="True" />
        <field name="perm_read" eval="False" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="groups" eval="[Command.link(ref('group_community_manager'))]" />
    </record>
</odoo>
