<data>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group name="sumit" invisible="code != 'sumit'">
                    <field
                        name="sumit_account_id"
                        required="code == 'sumit' and state != 'disabled'"
                    />
                </group>
            </group>
            <group name="provider_config" position="inside">
                <group name="sumit_config" invisible="code != 'sumit'" string="Sumit">
                    <field name="sumit_installment_threshold" />
                    <field name="sumit_installment_count" />
                </group>
            </group>
        </field>
    </record>
</data>
