<templates>
<t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_switch_company_menu')]" position="attributes">
        <attribute name="t-if">companiesEntries.length > 1</attribute>
    </xpath>
</t>
<t t-name="operating_unit_switcher.menu" t-inherit="web.SwitchCompanyMenu">
    <xpath expr="//div[hasclass('o_switch_company_menu')]" position="attributes">
        <attribute
                name="class"
                add="o_switch_ou_menu"
                remove="o_switch_company_menu"
                separator=" "
            />
    </xpath>
</t>
</templates>
