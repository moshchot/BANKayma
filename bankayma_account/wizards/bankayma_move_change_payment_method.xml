<odoo>
    <record id="view_bankayma_move_change_payment_method_form" model="ir.ui.view">
        <field name="model">bankayma.move.change.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="payment_method_id" />
                </group>
                <footer>
                    <button
                        name="action_change_method"
                        type="object"
                        string="Change method"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record
        id="action_bankayma_move_change_payment_method_form"
        model="ir.actions.act_window"
    >
        <field name="name">Change payment method</field>
        <field name="res_model">bankayma.move.change.payment.method</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
