<odoo>
    <record id="view_bankayma_move_change_company_form" model="ir.ui.view">
        <field name="model">bankayma.move.change.company</field>
        <field name="arch" type="xml">
            <form>
                <field name="has_nondraft_moves" invisible="True" />
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="not has_nondraft_moves"
                >
                    You cannot change the operating unit of non-draft moves
                </div>
                <group invisible="has_nondraft_moves">
                    <field
                        name="operating_unit_id"
                        domain="[('id', '!=', current_operating_unit_id)]"
                        options="{'no_create': True}"
                    />
                    <field name="current_operating_unit_id" invisible="1" />
                </group>
                <footer invisible="has_nondraft_moves">
                    <button
                        type="object"
                        name="action_change_operating_unit"
                        class="btn btn-primary"
                        string="Change Operating Unit"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bankayma_move_change_company_form" model="ir.actions.act_window">
        <field name="name">Change Operating Unit</field>
        <field name="res_model">bankayma.move.change.company</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
