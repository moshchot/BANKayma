<odoo>
    <record id="view_bankayma_ou_create_form" model="ir.ui.view">
        <field name="model">bankayma.ou.create</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="template_operating_unit_id" />
                    <field name="user_file" />
                    <separator string="or" />
                    <field name="ou_code" required="not user_file" />
                    <field name="ou_name" required="not user_file" />
                    <field name="user_function" />
                    <field name="user_login" />
                    <field name="user_name" />
                    <field name="user_email" />
                    <field name="user_phone" />
                </group>
                <footer>
                    <button
                        name="action_create"
                        type="object"
                        string="Create"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bankayma_ou_create" model="ir.actions.act_window">
        <field name="name">Create OUs</field>
        <field name="res_model">bankayma.ou.create</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>

    <menuitem
        id="menu_bankayma_ou_create"
        action="action_bankayma_ou_create"
        parent="base.menu_users"
    />
</odoo>
