<odoo>
    <record id="res_company_code.company_test" model="res.company">
        <field name="parent_id" ref="base.main_company" />
        <field name="company_cascade_from_parent" eval="True" />
    </record>
    <record id="l10n_il.demo_company_il" model="res.company">
        <field name="parent_id" ref="base.main_company" />
        <field name="company_cascade_from_parent" eval="True" />
    </record>
    <function model="account.chart.template" name="try_loading">
        <value eval="[ref('l10n_il.il_chart_template')]" />
        <value model="res.company" eval="obj().env.ref('base.main_company')" />
    </function>
    <function model="ir.sequence" name="write">
        <value
            model="ir.sequence"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
        <value eval="{'company_id': False}" />
    </function>
    <function model="ir.sequence" name="_company_cascade">
        <value
            model="ir.sequence"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
    <function model="account.account" name="_company_cascade">
        <value
            model="account.account"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
    <function model="account.journal" name="_company_cascade">
        <value
            model="account.journal"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
    <function model="account.payment.mode" name="_company_cascade">
        <value
            model="account.payment.mode"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
    <function model="account.tax" name="_company_cascade">
        <value
            model="account.tax"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
    <function model="account.fiscal.position" name="_company_cascade">
        <value
            model="account.fiscal.position"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
    <function model="account.fiscal.position.tax" name="_company_cascade">
        <value
            model="account.fiscal.position.tax"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
    <function model="res.company" name="_company_cascade">
        <value eval="ref('base.main_company')" />
    </function>
    <function model="ir.property" name="_company_cascade">
        <value
            model="ir.property"
            eval="obj([]).search([('company_id', '=', ref('base.main_company'))]).ids"
        />
    </function>
</odoo>
