<odoo>
    <record id="journal_overhead" model="account.journal">
        <field name="name">Overhead</field>
        <field name="code">OVR</field>
        <field name="type">sale</field>
        <field name="company_id" ref="base.main_company" />
        <field name="sequence">100</field>
        <field name="bankayma_restrict_partner">intercompany</field>
    </record>

    <record id="journal_donations" model="account.journal">
        <field name="name">Donations</field>
        <field name="code">DON</field>
        <field name="type">sale</field>
        <field name="company_id" ref="base.main_company" />
        <field name="sequence">100</field>
        <!-- crucial that this is type 4 -->
        <field name="sumit_type">4</field>
    </record>

    <record id="journal_inter_ou" model="account.journal">
        <field name="name">Inter OU</field>
        <field name="code">INT</field>
        <field name="type">general</field>
        <field name="company_id" ref="base.main_company" />
        <field name="sequence">100</field>
    </record>

    <!-- oca-hooks:disable=xml-duplicate-record-id -->
    <record id="base.main_company" model="res.company">
        <field name="overhead_journal_id" ref="journal_overhead" />
        <field name="donation_journal_id" ref="journal_donations" />
        <field name="inter_ou_journal_id" ref="journal_inter_ou" />
    </record>

    <function name="write" model="account.journal">
        <value model="account.journal" eval="obj([]).search([]).ids" />
        <value
            eval="{
            'bankayma_mail_template_portal_vendor_bill': ref('template_account_move_new_from_portal'),
            'bankayma_mail_template_tier_validation_reject': ref('template_account_move_rejected'),
            'bankayma_mail_template_invoice_paid': ref('template_account_move_paid'),
        }"
        />
    </function>
</odoo>
