<odoo>
    <record id="base.default_user" model="res.users">
        <field
            name="groups_id"
            eval="[Command.unlink(ref('account.group_account_manager')), Command.unlink(ref('account.group_account_user')), Command.unlink(ref('account.group_account_invoice')), Command.unlink(ref('sales_team.group_sale_manager'))]"
        />
    </record>

    <record id="base.user_admin" model="res.users">
        <field
            name="groups_id"
            eval="[Command.link(ref('bankayma_base.group_manager')), Command.link(ref('bankayma_base.group_org_manager')), Command.link(ref('bankayma_base.group_full'))]"
        />
    </record>

    <record id="base.group_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('analytic.group_analytic_accounting')), Command.link(ref('account.group_account_invoice'))]"
        />
    </record>

    <record id="bankayma_base.group_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('account.group_account_invoice'))]"
        />
    </record>

    <record
        id="account_operating_unit.ir_rule_move_line_allowed_operating_units"
        model="ir.rule"
    >
        <field name="domain_force">
            [
            '|', '|', '|',
            ('operating_unit_id', '=', False),
            ('operating_unit_id', 'in', operating_unit_ids),
            ('move_id.inter_ou_target_id.id', 'in', operating_unit_ids),
            ('move_id.inter_ou_source_id.id', 'in', operating_unit_ids),
            ]
        </field>
    </record>
</odoo>
