<odoo>
    <record id="res_config_settings_view_form_account" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="fiscal_localization_setting_container" position="after">
                <block name="bankayma_account" title="Bankayma-specific">
                    <setting string="Overhead">
                        <div class="content-group">
                        <div class="row">
                            <label
                                    string="Journal"
                                    class="o_light_label col-lg-3"
                                    for="overhead_journal_id"
                                />
                            <field
                                    name="overhead_journal_id"
                                    domain="[('company_id', '=', company_id)]"
                                    required="True"
                                />
                        </div>
                        <div class="row">
                            <label
                                    string="Account"
                                    class="o_light_label col-lg-3"
                                    for="overhead_account_id"
                                />
                            <field name="overhead_account_id" required="True" />
                        </div>
                        </div>
                    </setting>
                    <setting string="Inter OU">
                        <div class="content-group">
                        <div class="row">
                            <label
                                    string="Journal"
                                    class="o_light_label col-lg-3"
                                    for="inter_ou_journal_id"
                                />
                            <field name="inter_ou_journal_id" required="True" />
                        </div>
                        <div class="row">
                            <label
                                    string="Product"
                                    for="inter_ou_product_id"
                                    class="o_light_label col-lg-3"
                                />
                            <field name="inter_ou_product_id" required="True" />
                        </div>
                        </div>
                    </setting>
                    <setting string="Donations">
                        <div class="content-group">
                        <div class="row">
                            <label
                                    string="Journal"
                                    class="o_light_label col-lg-3"
                                    for="donation_journal_id"
                                />
                        <field
                                    name="donation_journal_id"
                                    required="True"
                                    domain="[('company_id', '=', company_id)]"
                                />
                        </div>
                        <div class="row">
                            <label
                                    string="Product"
                                    for="donation_credit_transfer_product_id"
                                    class="o_light_label col-lg-3"
                                />
                            <field
                                    name="donation_credit_transfer_product_id"
                                    required="True"
                                />
                        </div>
                        </div>
                    </setting>
                    <setting />
                    <setting>
                        <field name="show_bankayma_tax_totals_out_invoice" />
                    </setting>
                    <setting>
                        <field name="show_bankayma_tax_totals_in_invoice" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
