<odoo>
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <button name="button_draft" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_manager,bankayma_base.group_org_manager,bankayma_base.group_full</attribute>
                <!-- prettier-ignore-end -->
            </button>
            <button name="action_register_payment" position="attributes">
                <attribute name="groups">bankayma_base.group_org_manager</attribute>
            </button>
            <button
                name="%(account.action_view_account_move_reversal)d"
                position="attributes"
            >
                <attribute name="groups">account.group_account_manager</attribute>
            </button>
            <button name="action_reverse" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </button>
            <xpath expr="//button[@name='button_cancel'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_cancel'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <button name="preview_invoice" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="invisible">
                    move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')
                </attribute>
                <!-- prettier-ignore-end -->
            </button>
            <button name="button_cancel" position="before">
                <field name="need_validation" invisible="True" />
                <field name="reviewer_ids" invisible="True" />
                <button
                    name="button_cancel_unlink"
                    string="Delete"
                    type="object"
                    groups="account.group_account_invoice"
                    invisible="(state != 'draft') or need_validation or ((state == 'draft') and ('reviewer_ids', '!=', False))"
                />
            </button>
            <xpath expr="//sheet/*[1]" position="before">
                <h5>
                    <field
                        name="operating_unit_id"
                        widget="many2one"
                        options="{'no_open': True, 'no_create': True}"
                        readonly="1"
                    />
                </h5>
            </xpath>
            <field name="payment_reference" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <field name="payment_mode_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <field name="narration" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <field name="invoice_vendor_bill_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <label for="invoice_vendor_bill_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </label>
            <xpath
                expr="//group[@id='header_right_group']/field[@name='date']"
                position="attributes"
            >
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <xpath expr="//label[@for='invoice_date']" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <xpath expr="//label[@for='invoice_date'][2]" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <field name="invoice_date" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <xpath
                expr="//field[@name='invoice_date_due']/parent::div[hasclass('d-flex')]"
                position="attributes"
            >
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <xpath
                expr="//label[@for='invoice_date_due']/parent::div[hasclass('o_td_label')]"
                position="attributes"
            >
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <xpath
                expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']"
                position="attributes"
            >
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_org_manager,bankayma_base.group_full</attribute>
                <!-- prettier-ignore-end -->
            </xpath>
            <page id="aml_tab" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </page>
            <page id="other_tab" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </page>
            <label for="journal_id" position="attributes">
                <attribute name="groups">bankayma_base.group_org_manager</attribute>
            </label>
            <div name="journal_div" position="attributes">
                <attribute name="groups">bankayma_base.group_org_manager</attribute>
            </div>
            <field name="partner_bank_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/control/create[@name='add_section_control']"
                position="replace"
            />
            <xpath
                expr="//field[@name='invoice_line_ids']/list/control/create[@name='add_note_control']"
                position="replace"
            />
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field name="bankayma_product_domain" column_invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="attributes"
            >
                <attribute name="domain">bankayma_product_domain</attribute>
                <attribute name="string">Item</attribute>
                <attribute name="options">{'no_open': True}</attribute>
                <attribute name="required">True</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']"
                position="after"
            >
                <field name="account_id" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                position="attributes"
            >
                <attribute name="string">Description</attribute>
                <attribute name="required">True</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='analytic_distribution']"
                position="after"
            >
                <field name="bankayma_edit_buffer" column_invisible="True" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='analytic_distribution']"
                position="attributes"
            >
                <attribute name="string">Tag</attribute>
            </xpath>
            <xpath expr="//div/field[@name='partner_id']/.." position="after">
                <field name="fiscal_position_id" position="move" />
                <field name="bankayma_partner_domain" invisible="1" />
            </xpath>
            <field name="fiscal_position_id" position="before">
                <field name="show_fiscal_position_id" invisible="1" />
            </field>
            <field name="fiscal_position_id" position="attributes">
                <attribute name="invisible">
                    not show_fiscal_position_id
                </attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </field>
            <field name="fiscal_position_id" position="after">
                <div
                    class="o_col"
                    invisible="not bankayma_tax_removal_label and not bankayma_show_edit_tax_totals"
                />
                <div
                    class="o_col"
                    invisible="not bankayma_tax_removal_label and not bankayma_show_edit_tax_totals"
                >
                    <button
                        name="action_bankayma_remove_taxes"
                        type="object"
                        invisible="not bankayma_tax_removal_label"
                    >
                        <field name="bankayma_tax_removal_label" />
                    </button>
                    <field name="bankayma_show_edit_tax_totals" invisible="1" />
                    <button
                        type="object"
                        name="action_bankayma_move_edit_tax_totals"
                        string="Edit taxes"
                        groups="bankayma_base.group_org_manager"
                        invisible="not bankayma_show_edit_tax_totals"
                    />
                </div>
                <field name="bankayma_deduct_tax" invisible="True" />
                <field name="bankayma_deduct_tax_use_max_amount" invisible="True" />
                <label
                    for="bankayma_vendor_tax_percentage"
                    invisible="not bankayma_deduct_tax or move_type != 'in_invoice'"
                />
                <span
                    class="o_col"
                    invisible="not bankayma_deduct_tax or move_type != 'in_invoice'"
                >
                    <field name="bankayma_vendor_tax_percentage" readonly="True" />
                    <button
                        name="button_bankayma_vendor_tax_create"
                        type="object"
                        string="Create"
                        invisible="not bankayma_deduct_tax or move_type != 'in_invoice' or bankayma_vendor_tax_exists or bankayma_vendor_tax_percentage &lt;= 0"
                        class="btn btn-secondary"
                        colspan="2"
                    />
                </span>
                <field name="bankayma_vendor_tax_exists" invisible="True" />
                <label
                    for="bankayma_vendor_max_amount"
                    invisible="not bankayma_deduct_tax or move_type != 'in_invoice'"
                />
                <div
                    class="o_col"
                    invisible="not bankayma_deduct_tax or move_type != 'in_invoice'"
                >
                    <field
                        name="bankayma_vendor_max_amount"
                        class="oe_inline"
                        readonly="True"
                    />
                    <!-- prettier-ignore-start -->
                    <span> (paid this year: </span>
                    <!-- prettier-ignore-end -->
                    <field
                        name="bankayma_vendor_amount_this_year"
                        class="oe_inline"
                        invisible="move_type != 'in_invoice'"
                    />
                    <span>)</span>
                </div>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="domain">bankayma_partner_domain</attribute>
                <attribute name="context">
                    {
                    'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or
                    False,
                    'show_address': False,
                    'default_is_company': True,
                    'show_vat': False,
                    'bankayma_partner_address_email': True,
                    'bankayma_partner_address_vat': context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt'),
                    'bankayma_partner_address_language': context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt'),
                }
                </attribute>
            </field>
            <field name="tax_totals" position="attributes">
                <attribute name="invisible">
                    show_bankayma_tax_totals
                </attribute>
            </field>
            <field name="tax_totals" position="after">
                <field
                    name="bankayma_tax_totals"
                    nolabel="1"
                    colspan="2"
                    invisible="not show_bankayma_tax_totals"
                />
                <field name="show_bankayma_tax_totals" invisible="True" />
            </field>
            <form position="inside">
                <field name="review_ids" invisible="1" />
            </form>
            <xpath
                expr="//field[@name='invoice_line_ids']//button[@name='account_move_update_analytic.action_view_account_move_update_analytic']"
                position="attributes"
            >
                <attribute name="column_invisible">
                    parent.state != 'posted' and not parent.review_ids
                </attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']//form//field[@name='analytic_distribution']"
                position="after"
            >
                <field name="parent_state" invisible="1" />
                <div invisible="parent_state != 'posted'" />
                <button
                    name="account_move_update_analytic.action_view_account_move_update_analytic"
                    type="action"
                    groups="analytic.group_analytic_accounting"
                    invisible="parent_state != 'posted'"
                    icon="fa-tags"
                    title="Update analytic distribution"
                    aria-label="Update analytic distribution"
                >
                    Change analytic distribution
                </button>
            </xpath>
            <xpath expr="(//field[@name='ref'])[1]" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_manager,bankayma_base.group_full</attribute>
                <!-- prettier-ignore-end -->
            </xpath>
            <xpath expr="(//field[@name='ref'])[2]" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_manager,bankayma_base.group_full</attribute>
                <!-- prettier-ignore-end -->
            </xpath>
            <xpath expr="(//field[@name='ref'])[3]" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_manager,bankayma_base.group_full</attribute>
                <!-- prettier-ignore-end -->
            </xpath>
            <notebook position="inside">
                <page
                    name="bankayma_extra"
                    string="Extra settings"
                    groups="bankayma_base.group_org_manager"
                    invisible="move_type != 'out_invoice'"
                >
                    <group>
                        <field
                            name="bankayma_waive_overhead"
                            groups="bankayma_base.group_org_manager"
                        />
                        <field
                            name="bankayma_waive_overhead"
                            readonly="True"
                            groups="!bankayma_base.group_org_manager"
                        />
                        <field
                            name="bankayma_overhead_percentage"
                            groups="bankayma_base.group_org_manager"
                        />
                        <field
                            name="bankayma_overhead_percentage"
                            readonly="True"
                            groups="!bankayma_base.group_org_manager"
                        />
                        <field
                            name="sumit_document_url"
                            readonly="state != 'draft'"
                            widget="url"
                        />
                        <field
                            name="sumit_document_number"
                            readonly="state != 'draft'"
                        />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_account_move_tree_invoice" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="amount_total_in_currency_signed" position="after">
                <field
                    name="bankayma_move_line_analytic_distribution"
                    widget="analytic_distribution"
                    options="{'product_field': 'bankayma_move_line_product_id', 'account_field': 'bankayma_move_line_account_id'}"
                />
                <field name="bankayma_move_line_account_id" invisible="True" />
                <field name="bankayma_move_line_product_id" />
                <field name="bankayma_move_line_name" />
                <field name="bankayma_amount_paid" sum="Total" />
                <field name="bankayma_payment_date" />
                <field name="bankayma_payment_method_id" />
            </field>
            <field name="invoice_date_due" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
        </field>
    </record>

    <record id="view_in_invoice_tree" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree" />
        <field name="arch" type="xml">
            <field name="bankayma_amount_paid" position="after">
                <field name="fiscal_position_id" optional="show" />
                <field name="bankayma_partner_vat" optional="show" />
                <field name="bankayma_attachment_ids" optional="show" />
            </field>
            <field name="invoice_date_due" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
        </field>
    </record>

    <record id="view_failed_sys1k_moves" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="display_name" />
                <field name="system1000_error_message" />
            </list>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="journal_id" position="before">
                <field name="bankayma_move_line_analytic_account_id" />
                <field name="bankayma_move_line_product_id" />
                <field name="bankayma_move_line_product_category_id" />
            </field>
            <filter name="myinvoices" position="before">
                <filter
                    name="bankayma_payment_date"
                    string="Payment date"
                    date="bankayma_payment_date"
                />
                <filter
                    name="has_analytics"
                    string="Has analytics"
                    domain="[('invoice_line_ids.analytic_distribution', '!=', False)]"
                />
                <filter
                    name="has_activity"
                    string="Has activity"
                    domain="[('activity_ids', '!=', False)]"
                />
                <separator />
            </filter>
            <filter name="status" position="after">
                <filter
                    name="bankayma_move_line_product_id"
                    string="Product"
                    context="{'group_by': 'bankayma_move_line_product_id'}"
                />
                <filter
                    name="bankayma_move_line_product_category_id"
                    string="Product Category"
                    context="{'group_by': 'bankayma_move_line_product_category_id'}"
                />
            </filter>
            <filter name="salesperson" position="before">
                <filter
                    name="groupby_bankayma_payment_date"
                    string="Payment date"
                    context="{'group_by': 'bankayma_payment_date'}"
                />
            </filter>
            <field name="journal_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <field name="invoice_user_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <filter name="draft" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="posted" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="cancel" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <xpath
                expr="//filter[@name='cancel']/following-sibling::separator"
                position="attributes"
            >
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <filter name="open" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="late" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <xpath
                expr="//filter[@name='late']/following-sibling::separator"
                position="attributes"
            >
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <filter name="date" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="due_date" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="needs_review" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="no_validation_requested" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="validation_not_started" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="validation_in_progress" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="tier_validated" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <xpath
                expr="//filter[@name='needs_review']/preceding-sibling::separator"
                position="attributes"
            >
                <attribute name="groups">bankayma_base.group_full</attribute>
            </xpath>
            <filter name="salesperson" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="salesperson" position="after">
                <filter
                    name="validated_state"
                    string="Validated state"
                    context="{'group_by':'validated_state'}"
                />
                <filter
                    name="partner_id"
                    string="Partner"
                    context="{'group_by':'partner_id'}"
                />
                <filter
                    name="company_id"
                    string="Company"
                    context="{'group_by':'company_id'}"
                />
            </filter>
            <filter name="payment_mode_groupby" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </filter>
            <filter name="payment_mode_groupby" position="after">
                <filter
                    string="Payment Method"
                    name="bankayma_payment_method_id"
                    context="{'group_by': 'bankayma_payment_method_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
