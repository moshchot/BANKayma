<odoo>
    <record id="bankayma_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="bankayma_base.bankayma_partner_form" />
        <field name="arch" type="xml">
            <form position="inside">
                <field name="show_warning_vat_required" invisible="True" />
                <field name="duplicated_bank_account_partners_count" invisible="True" />
                <field name="supplier_rank" invisible="True" />
            </form>
            <page name="accounting" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </page>
            <xpath
                expr="//group[@name='bankayma_right']/field[@name='bank_ids']"
                position="before"
            >
                <field
                    name="property_account_position_id"
                    required="supplier_rank &gt; 0"
                />
                <field name="bankayma_deduct_tax" invisible="True" />
                <field
                    name="bankayma_show_tax_deduction"
                    invisible="not bankayma_deduct_tax"
                />
                <field
                    name="bankayma_vendor_tax_percentage"
                    invisible="not bankayma_show_tax_deduction"
                />
                <field
                    name="bankayma_vendor_max_amount"
                    invisible="not bankayma_show_tax_deduction"
                />
                <field name="bankayma_available_tax_group_ids" invisible="True" />
                <field
                    name="bankayma_tax_group_id"
                    domain="[('id', 'in', bankayma_available_tax_group_ids)]"
                    invisible="not bankayma_available_tax_group_ids"
                />
            </xpath>
            <xpath
                expr="//group[@name='bankayma_top']//field[@name='vat']"
                position="attributes"
            >
                <attribute name="required">supplier_rank</attribute>
            </xpath>
            <xpath
                expr="//group[@name='bankayma_top']//field[@name='bank_ids']"
                position="attributes"
            >
                <attribute name="required">supplier_rank</attribute>
            </xpath>
            <button name="action_reset_password" position="after">
                <button
                    string="Invite Vendor"
                    type="object"
                    name="action_invite_vendor"
                    invisible="not user_ids"
                />
            </button>
            <button name="action_view_partner_invoices" position="attributes">
                <attribute name="invisible">
                    total_invoiced == 0
                </attribute>
            </button>
            <button name="action_view_partner_invoices" position="after">
                <button
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    name="action_view_partner_bills"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    context="{'default_partner_id': id}"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field
                                name="total_billed"
                                widget='monetary'
                                options="{'currency_field': 'currency_id'}"
                            />
                        </span>
                        <span class="o_stat_text">Billed</span>
                    </div>
                </button>
            </button>
            <!-- prettier-ignore-start -->
            <page name="sales_purchases" position="attributes">
                <attribute name="groups">bankayma_base.group_full,base.group_no_one</attribute>
            </page>
            <!-- prettier-ignore-end -->
        </field>
    </record>
</odoo>
