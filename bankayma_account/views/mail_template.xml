<odoo>
    <record id="email_template_form" model="ir.ui.view">
        <field name="inherit_id" ref="mail.email_template_form" />
        <field name="model">mail.template</field>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="bankayma_account" string="Journals">
                    <group>
                        <field
                            name="bankayma_portal_vendor_bill_journal_ids"
                            widget="many2many_tags"
                        />
                        <field
                            name="bankayma_tier_validation_reject_journal_ids"
                            widget="many2many_tags"
                        />
                        <field
                            name="bankayma_invoice_paid_journal_ids"
                            widget="many2many_tags"
                        />
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
