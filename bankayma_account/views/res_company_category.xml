<odoo>
    <record id="view_res_company_category_form" model="ir.ui.view">
        <field name="inherit_id" ref="bankayma_base.view_res_company_category_form" />
        <field name="model">res.company.category</field>
        <field name="arch" type="xml">
            <group name="bankayma_company_flags" position="inside">
                <field name="available_for_intercompany_invoices" />
            </group>
            <group name="bankayma_company_flags" position="after">
                <group
                    name="bankayma_company_website_flags"
                    string="Company properties (website)"
                >
                    <field name="available_for_portal" />
                </group>
            </group>
        </field>
    </record>
</odoo>
