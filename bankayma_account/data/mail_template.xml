        <field name="model_id" ref="account.model_account_move" />
        <field name="lang">{{object.partner_id.lang}}</field>
        <!-- prettier-ignore-start -->
        <field name="subject">[Bar-Kayma] {{object.company_id.name}} payment on hold for insufficient documents</field>
        <!-- prettier-ignore-end -->
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="post_to_chatter" eval="True" />
        <field name="description">
            This mail is sent when a payment request is rejected
        </field>
        <field name="body_html" type="html">
            <t t-call="bankayma_base.mail_header" />
            <div>
                <h1>
                    Dear
                    <t t-if="object.partner_id.parent_id">
                        <t t-out="object.partner_id.name or ''" t-translation="off">
                            Brandon Freeman
