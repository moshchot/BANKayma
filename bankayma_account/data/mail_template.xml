<odoo noupdate="1">
    <record id="template_vendor_invite" model="mail.template" forcecreate="1">
        <field name="name">Invitation to vendor portal</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="subject">Invitation to vendor portal</field>
        <field name="partner_to">{{object.id}}</field>
        <field name="description">This mail is sent when a vendor is invited</field>
        <field name="body_html" type="html">
            <h1>Welcome aboard our BANKayma vendors portal:)</h1>
            <div>
                Please follow this
                <a
                    t-attf-href="{{ object.signup_url }}&amp;redirect=%2Fmy%2Faccount%3Fredirect%3D%2Fmy%2Finvoices%2Fnew"
                >
                    link
                </a>
                and get paid 🤑
            </div>
        </field>
    </record>
    <record id="account.email_template_edi_invoice" model="mail.template">
        <field name="body_type">qweb_view</field>
        <field name="body_view_id" ref="qweb_template_edi_invoice" />
    </record>
    <record
        id="template_account_move_new_from_portal"
        model="mail.template"
        forcecreate="1"
    >
        <field name="name">BNK Vendor: Payment request recieved</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="lang">{{object.partner_id.lang}}</field>
        <!-- prettier-ignore-start -->
        <field name="subject">[BanKayma] Payment request from {{object.company_id.name}}</field>
        <!-- prettier-ignore-end -->
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="post_to_chatter" eval="True" />
        <field name="description">
            This mail is sent when a payment request is received
        </field>
        <field name="body_html" type="html">
            <t t-call="bankayma_base.mail_header" />
            <div>
                <h1>
                    Dear
                    <t t-if="object.partner_id.parent_id">
                        <t t-out="object.partner_id.name or ''" t-translation="off">
                            Brandon Freeman
                        </t>
                        (
                        <t
                            t-out="object.partner_id.parent_id.name or ''"
                            t-translation="off"
                        >
                            Azure Interior
                        </t>
                        ),
                    </t>
                    <t t-else="">
                        <t t-out="object.partner_id.name or ''" t-translation="off">
                            Brandon Freeman
                        </t>
                        ,
                    </t>
                </h1>
                <p>
                    Your payment request of
                    <t t-out="sum(object.mapped('invoice_line_ids.price_subtotal'))" />
                    for
                    <t t-out="', '.join(object.mapped('invoice_line_ids.name'))" />
                    was recieved with this info:
                </p>
            </div>
            <table>
                <tr>
                    <th>Recipient Bank info:</th>
                    <td t-foreach="object.partner_id.bank_ids[:1]" t-as="bank_account">
                        <span t-out="bank_account.acc_number" />
                        ,
                        <span t-out="bank_account.branch_code" />
                        ,
                        <span t-out="bank_account.bank_id.bank_code" />
                        ,
                        <span t-out="bank_account.bank_id.name" />
                    </td>
                </tr>
                <tr>
                    <th>Tax ID:</th>
                    <td t-out="object.partner_id.vat" />
                </tr>
                <tr>
                    <th>Fiscal position:</th>
                    <td t-out="object.fiscal_position_id.name" />
                </tr>
                <tr>
                    <th>Tax deduction:</th>
                    <td>
                        <t t-if="object.bankayma_vendor_tax_percentage">
                            <t t-out="object.bankayma_vendor_tax_percentage" />
                        </t>
                        <t t-else="">no</t>
                    </td>
                </tr>
                <tr t-if="object.bankayma_deduct_tax_use_max_amount">
                    <th>Max amount:</th>
                    <td t-out="object.bankayma_vendor_max_amount" />
                </tr>
                <tr
                    t-foreach="object.mapped('invoice_line_ids.tax_ids.tax_group_id').sorted('name')"
                    t-as="tax_group"
                >
                    <th>
                        <span t-out="tax_group.name" />
                        :
                    </th>
                    <td>yes</td>
                </tr>
            </table>
            <p>
                Do not hesitate to contact us if you have any questions.
                <t t-if="object.invoice_user_id.sudo().signature">
                    <t
                        t-out="object.invoice_user_id.sudo().signature or ''"
                        t-translation="off"
                    >
                        --Bill Bot
                    </t>
                </t>
            </p>
            <t t-call="bankayma_base.mail_footer" />
        </field>
    </record>
