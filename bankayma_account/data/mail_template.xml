                        <span t-out="bank_account.bank_id.name" />
                    </td>
                </tr>
                <tr>
                    <th>Tax ID:</th>
                    <td t-out="object.partner_id.vat" />
                </tr>
                <tr>
                    <th>Fiscal position:</th>
                    <td t-out="object.fiscal_position_id.name" />
                </tr>
                <tr>
                    <th>Tax deduction:</th>
                    <td>
                        <t t-if="object.bankayma_vendor_tax_percentage">
                            <t t-out="object.bankayma_vendor_tax_percentage" />
                        </t>
                        <t t-else="">no</t>
                    </td>
                </tr>
                <tr t-if="object.bankayma_deduct_tax_use_max_amount">
                    <th>Max amount:</th>
                    <td t-out="object.bankayma_vendor_max_amount" />
                </tr>
                <tr
                    t-foreach="object.mapped('invoice_line_ids.tax_ids.tax_group_id').sorted('name')"
                    t-as="tax_group"
                >
                    <th>
                        <span t-out="tax_group.name" />
                        :
                    </th>
                    <td>yes</td>
                </tr>
            </table>
            <p>
                Do not hesitate to contact us if you have any questions.
                <t t-if="object.invoice_user_id.sudo().signature">
                    <t
                        t-out="object.invoice_user_id.sudo().signature or ''"
                        t-translation="off"
                    >
                        --Bill Bot
                    </t>
                </t>
            </p>
            <t t-call="bankayma_base.mail_footer" />
        </field>
    </record>
    <record id="template_account_move_paid" model="mail.template" forcecreate="1">
        <field name="name">BNK Vendor: Message after payment - send receipt</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="lang">{{object.partner_id.lang}}</field>
        <!-- prettier-ignore-start -->
        <field name="subject">[Bar-Kayma] {{object.company_id.name}} you've been paid! 🤑 (Ref {{object.ref}})</field>
        <!-- prettier-ignore-end -->
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="post_to_chatter" eval="True" />
        <field name="report_template" ref="account.account_invoices" />
        <!-- prettier-ignore-start -->
        <field name="report_name">Invoice_{{ (object.name or '').replace('/','_') }}</field>
        <!-- prettier-ignore-end -->
        <field name="description">
            This mail is sent when a payment request is paid
        </field>
        <field name="body_html" type="html">
            <t t-call="bankayma_base.mail_header" />
            <div>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                    You've been paid!
                    <br />
                    🤑
                    <br />
                    Hi
                    <t t-if="object.partner_id.parent_id">
                    <t t-out="object.partner_id.name or ''">Brandon Freeman</t>
                    <!-- prettier-ignore-start -->
                    (<t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>),
                    <!-- prettier-ignore-end -->
                </t>
                    <t t-else="">
                    <!-- prettier-ignore-start -->
                    <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
                    <!-- prettier-ignore-end -->
                </t>
                    <br />
                    <br />
                    Following your
                    <t t-if="object.name">
                        Payment Request
                        <span style="font-weight:bold;" t-out="object.name or ''">
                            INV/2021/05/0005
                        </span>
                    </t>
                    <t t-else="" />
                    <t t-if="object.invoice_origin">
                    <!-- prettier-ignore-start -->
                    (with reference: <t t-out="object.invoice_origin or ''">SUB003</t>)
                    <!-- prettier-ignore-end -->
                </t>
                </p>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                    We are happy to inform you that we've transferred
                    <span
                        style="font-weight:bold;"
                        t-field="object.amount_untaxed_signed"
                    />
                    on
                    <t t-out="object.bankayma_payment_date or ''" />
                    . for
                    <t t-out="', '.join(object.mapped('invoice_line_ids.name')) or ''">
                        description
                    </t>
                    . from
                    <t t-out="object.company_id.name or ''">YourCompany</t>
                    to
                    <t t-out="object.partner_bank_id or ''">your bank</t>
                </p>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                    <strong style="box-sizing:border-box;font-weight:800;">
                        Licensed or Exempt dealer? Please upload a receipt by replying
                        to
                    this email
                        <br />
                        <br />
                        To: Bar-Kayma for Culture 580450898
                        <br />
                    </strong>
                    Bank First Internation Bank of Israel (31),
                    <br />
                    Branch 012, Account 036218
                </p>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                    Love💜
                    <br />
                    Bill the robot
                </p>
            </div>
            <t t-call="bankayma_base.mail_footer" />
        </field>
    </record>
    <record
        id="template_account_move_paid_reminder"
        model="mail.template"
        forcecreate="1"
    >
        <field name="name">BNK Vendor: reminder to send receipt</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="lang">{{object.partner_id.lang}}</field>
        <!-- prettier-ignore-start -->
        <field name="subject">[Bar-Kayma] {{object.company_id.name}} reminder to send receipt (Ref {{object.ref}})</field>
        <!-- prettier-ignore-end -->
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="post_to_chatter" eval="True" />
        <field name="report_template" ref="account.account_invoices" />
        <!-- prettier-ignore-start -->
        <field name="report_name">Invoice_{{ (object.name or '').replace('/','_') }}</field>
        <!-- prettier-ignore-end -->
        <field name="description">
            This mail is sent as reminder to send a receipt
        </field>
        <field name="body_html" type="html">
            <t t-call="bankayma_base.mail_header" />
            <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                Hi
                <t t-if="object.partner_id.parent_id">
                <t t-out="object.partner_id.name or ''">Brandon Freeman</t>
                <!-- prettier-ignore-start -->
                (<t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>),
                <!-- prettier-ignore-end -->
            </t>
                <t t-else="">
                <!-- prettier-ignore-start -->
                <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
                <!-- prettier-ignore-end -->
            </t>
                <br />
                <br />
                According to our records, you haven't sent a reciept for
                <span
                    style="font-weight:bold;"
                    t-field="object.amount_untaxed_signed"
                />
                for
                <t t-out="', '.join(object.mapped('invoice_line_ids.name')) or ''">
                    description
                </t>
                paid on
                <t t-out="object.bankayma_payment_date or ''" />
                from
                <t t-out="object.company_id.name or ''">YourCompany</t>
                to
                <t t-out="object.partner_bank_id or ''">your bank</t>
            </p>
            <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                <strong style="box-sizing:border-box;font-weight:500;">
                    Please upload a receipt by replying to this email
                </strong>
                <br />
                <br />
                To: Bar-Kayma for Culture 580450898
                <br />
                Bank First Internation Bank of Israel (31),
                <br />
                Branch 012, Account 036218
            </p>
            <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                Love💜
                <br />
                Bill the robot
            </p>
            <t t-call="bankayma_base.mail_footer" />
        </field>
    </record>
</odoo>
