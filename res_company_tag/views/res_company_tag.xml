<odoo>
    <record id="view_res_company_tag_list" model="ir.ui.view">
        <field name="model">res.company.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="parent_id" />
            </tree>
        </field>
    </record>
    <record id="view_res_company_tag_form" model="ir.ui.view">
        <field name="model">res.company.tag</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="name" />
                    <field name="parent_id" />
                </group>
            </form>
        </field>
    </record>
    <record id="view_res_company_tag_search" model="ir.ui.view">
        <field name="model">res.company.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="parent_id" />
            </search>
        </field>
    </record>
    <record id="action_res_company_tag" model="ir.actions.act_window">
        <field name="name">Company Tags</field>
        <field name="res_model">res.company.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="menu_res_company_tag"
        action="action_res_company_tag"
        parent="base.menu_users"
    />
</odoo>
