<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web.SwitchCompanyMenu" owl="1" t-inherit-mode="extension">
        <xpath expr="//div[@name='select_all_companies']/../.." position="attributes">
            <attribute name="t-if">state.showCheckboxes</attribute>
        </xpath>
    </t>
    <t t-inherit="web.SwitchCompanyItem" owl="1" t-inherit-mode="extension">
        <xpath expr="//div[@role='menuitemcheckbox']/span" position="attributes">
            <attribute name="t-if">state.showCheckboxes</attribute>
        </xpath>
    </t>
</templates>
