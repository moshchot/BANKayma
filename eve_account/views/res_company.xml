<odoo>
    <record id="view_res_company_kanban" model="ir.ui.view">
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_res_company_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//templates//field[@name='name']/.." position="after">
                <field name="bankayma_overhead_percentage" class="mx-2" />
                %
            </xpath>
        </field>
    </record>
    <record id="view_company_form" model="ir.ui.view">
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <field name="currency_id" position="before">
                <field name="bankayma_overhead_percentage" />
            </field>
        </field>
    </record>
</odoo>
