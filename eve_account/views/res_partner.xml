<odoo>
    <record id="eve_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="bankayma_account.bankayma_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='bankayma_standard_moved']//group/group"
                position="inside"
            >
                <field name="eve_vendor_code" />
                <field name="eve_customer_code" />
            </xpath>
        </field>
    </record>
</odoo>
