<odoo>
    <record id="product_product_view_form_normalized_website_sale" model="ir.ui.view">
        <field
            name="inherit_id"
            ref="website_sale.product_product_view_form_normalized_website_sale"
        />
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="operating_unit_id" invisible="True" />
                <field name="list_price" required="True" widget="monetary" />
                <field
                    name="product_tag_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
                <field name="image_1920" required="True" widget="image" />
            </field>
            <field name="barcode" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <label for="taxes_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </label>
            <div name="tax_info" position="attributes">
                <attribute name="invisible">True</attribute>
            </div>
        </field>
    </record>
    <record id="website_sale.product_product_action_add" model="ir.actions.act_window">
        <field
            name="context"
            eval="&quot;{'dialog_size': 'medium', 'website_published': True, 'default_categ_id': %d}&quot; % ref('bankayma_website.product_category_webshop_product')"
        />
    </record>
</odoo>
