<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='group_standard_price']//field[@name='company_id']"
                position="after"
            >
                <field
                    name="bankayma_website_sale_company_id"
                    options="{'no_create': True, 'no_open': True}"
                />
            </xpath>
            <div name="options" position="after">
                <field name="sale_ok" invisible="True" />
                <field name="purchase_ok" invisible="True" />
            </div>
            <div name="options" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </div>
            <field name="categ_id" position="after">
                <field name="categ_id" invisible="True" />
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <xpath
                expr="//page[@name='general_information']//field[@name='company_id']"
                position="attributes"
            >
                <attribute name="groups">
                    bankayma_base.group_full,bankayma_base.group_org_manager
                </attribute>
            </xpath>
            <field name="taxes_id" position="attributes">
                <attribute name="groups">
                    bankayma_base.group_full,bankayma_base.group_org_manager
                </attribute>
            </field>
            <page name="purchase" position="attributes">
                <attribute name="groups">
                    bankayma_base.group_full,bankayma_base.group_org_manager
                </attribute>
            </page>
            <page name="invoicing" position="attributes">
                <attribute name="groups">
                    bankayma_base.group_full,bankayma_base.group_org_manager
                </attribute>
            </page>
            <page name="sumit" position="attributes">
                <attribute name="groups">
                    bankayma_base.group_full,bankayma_base.group_org_manager
                </attribute>
            </page>
            <group name="shop" position="attributes">
                <attribute name="groups">
                    bankayma_base.group_full,bankayma_base.group_org_manager
                </attribute>
            </group>
        </field>
    </record>
</odoo>
