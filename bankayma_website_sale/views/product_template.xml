<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='group_standard_price']//field[@name='company_id']"
                position="after"
            >
                <field
                    name="operating_unit_id"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="bankayma_website_sale_hide" />
            </xpath>
            <div name="options" position="after">
                <field name="sale_ok" invisible="True" />
                <field name="purchase_ok" invisible="True" />
            </div>
            <div name="options" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </div>
            <field name="categ_id" position="after">
                <field name="categ_id" invisible="True" />
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="groups">bankayma_base.group_full</attribute>
            </field>
            <xpath
                expr="//page[@name='general_information']//field[@name='company_id']"
                position="attributes"
            >
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_full,bankayma_base.group_org_manager</attribute>
                <!-- prettier-ignore-end -->
            </xpath>
            <field name="taxes_id" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_full,bankayma_base.group_org_manager</attribute>
                <!-- prettier-ignore-end -->
            </field>
            <page name="purchase" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_full,bankayma_base.group_org_manager</attribute>
                <!-- prettier-ignore-end -->
            </page>
            <page name="invoicing" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_full,bankayma_base.group_org_manager</attribute>
                <!-- prettier-ignore-end -->
            </page>
            <page name="sumit" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_full,bankayma_base.group_org_manager</attribute>
                <!-- prettier-ignore-end -->
            </page>
            <group name="extra_info" position="attributes">
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_full,bankayma_base.group_org_manager</attribute>
                <!-- prettier-ignore-end -->
            </group>
            <field name="optional_product_ids" position="attributes">
                <attribute name="domain" operation="domain_add">
                    [('operating_unit_id', '=', operating_unit_id)]
                </attribute>
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_manager,bankayma_website.group_website</attribute>
                <!-- prettier-ignore-end -->
            </field>
            <field name="accessory_product_ids" position="attributes">
                <attribute name="domain" operation="domain_add">
                    [('operating_unit_id', '=', operating_unit_id)]
                </attribute>
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_manager,bankayma_website.group_website</attribute>
                <!-- prettier-ignore-end -->
            </field>
            <field name="alternative_product_ids" position="attributes">
                <attribute name="domain" operation="domain_add">
                    [('operating_unit_id', '=', operating_unit_id)]
                </attribute>
                <!-- prettier-ignore-start -->
                <attribute name="groups">bankayma_base.group_manager,bankayma_website.group_website</attribute>
                <!-- prettier-ignore-end -->
            </field>
            <field name="alternative_product_ids" position="after">
                <field
                    name="optional_product_ids"
                    groups="!bankayma_base.group_manager,!bankayma_website.group_website"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    placeholder="Recommend when 'Adding to Cart' or quotation"
                    invisible="not sale_ok"
                />
                <field
                    name="accessory_product_ids"
                    widget="many2many_tags"
                    invisible="not sale_ok"
                    groups="!bankayma_base.group_manager,!bankayma_website.group_website"
                    placeholder="Suggested accessories in the eCommerce cart"
                />
                <field
                    name="alternative_product_ids"
                    widget="many2many_tags"
                    groups="!bankayma_base.group_manager,!bankayma_website.group_website"
                    domain="['|', ('operating_unit_id', '=', operating_unit_id), ('operating_unit_id', '=', False)]"
                    invisible="not sale_ok"
                    placeholder="Displayed in bottom of product pages"
                />
            </field>
        </field>
    </record>
</odoo>
