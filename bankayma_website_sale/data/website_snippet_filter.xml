<odoo>
    <record id="filter_ordered_products" model="ir.filters">
        <field name="name">Ordered Products</field>
        <field name="model_id">product.product</field>
        <field name="user_id" eval="False" />
        <field name="domain">[('website_published', '=', True)]</field>
        <!-- prettier-ignore-start -->
        <field name="context">{'display_default_code': False, 'add2cart_rerender': False}</field>
        <!-- prettier-ignore-end -->
        <field name="sort">["website_sequence"]</field>
        <field name="action_id" ref="website.action_website" />
    </record>
    <record id="snippet_filter_ordered_products" model="website.snippet.filter">
        <field name="filter_id" ref="filter_ordered_products" />
        <field name="field_names">display_name,description_sale,image_512</field>
        <field name="limit" eval="16" />
        <field name="name">Ordered Products</field>
    </record>
    <record id="action_random_products" model="ir.actions.server">
        <field name="name">Random products</field>
        <field name="model_id" ref="product.model_product_product" />
        <field name="state">code</field>
        <!-- prettier-ignore-start -->
        <field name="code">
DynamicFilter = model.env['website.snippet.filter']
response = DynamicFilter._get_products('random', model.env.context)
        </field>
        <!-- prettier-ignore-end -->
    </record>
    <record id="snippet_filter_random_products" model="website.snippet.filter">
        <field name="action_server_id" ref="action_random_products" />
        <field name="field_names">display_name,description_sale,image_512</field>
        <field name="limit" eval="16" />
        <field name="name">Random Products</field>
    </record>
</odoo>
