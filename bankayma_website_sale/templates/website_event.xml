<odoo>
    <template
        id="event_description_full"
        inherit_id="website_event.event_description_full"
    >
        <xpath expr="//div[hasclass('o_wevent_sidebar_block')]" position="before">
            <div class="o_wevent_sidebar_block" t-if="event.tag_ids">
                <t
                    t-foreach="event.tag_ids.filtered(lambda tag: tag.category_id.is_published)"
                    t-as="tag"
                >
                    <span
                        t-if="tag.color"
                        t-attf-class="badge mr4 #{'o_tag_color_%s' % tag.color if tag.color else ''}"
                    >
                        <span t-out="tag.name" />
                    </span>
                </t>
            </div>
        </xpath>
    </template>
    <template
        id="registration_template"
        inherit_id="website_event.registration_template"
    >
        <xpath
            expr="(//t[@t-call='website_event.registration_configure_tickets_button'])[1]"
            position="attributes"
        >
            <attribute name="t-if" separator=" " add=" and False" />
        </xpath>
        <xpath
            expr="(//t[@t-call='website_event.registration_configure_tickets_button'])[2]"
            position="attributes"
        >
            <attribute name="t-if" separator=" " add=" and False" />
        </xpath>
        <xpath
            expr="(//t[@t-call='website_event.registration_configure_tickets_button'])[3]"
            position="attributes"
        >
            <attribute name="t-if" separator=" " add=" and False" />
        </xpath>
        <!-- remove time zone after dates and their enclosing brackets -->
        <xpath
            expr="//div[hasclass('alert')]//span[@t-out='event.date_tz']"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <wraptext
            expr="(//span[@t-out='ticket.event_id.date_tz'])[1]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='ticket.event_id.date_tz'])[1]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext
            expr="(//span[@t-out='ticket.event_id.date_tz'])[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='ticket.event_id.date_tz'])[1]/following-sibling::t"
            position="replace"
        />
        <xpath
            expr="(//span[@t-out='ticket.event_id.date_tz'])[1]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <wraptext
            expr="(//span[@t-out='ticket.event_id.date_tz'])[2]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='ticket.event_id.date_tz'])[2]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext
            expr="(//span[@t-out='ticket.event_id.date_tz'])[2]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='ticket.event_id.date_tz'])[2]/following-sibling::t"
            position="replace"
        />
        <xpath
            expr="(//span[@t-out='ticket.event_id.date_tz'])[2]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <wraptext
            expr="(//span[@t-out='tickets.event_id.date_tz'])[1]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='tickets.event_id.date_tz'])[1]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext
            expr="(//span[@t-out='tickets.event_id.date_tz'])[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='tickets.event_id.date_tz'])[1]/following-sibling::t"
            position="replace"
        />
        <xpath
            expr="(//span[@t-out='tickets.event_id.date_tz'])[1]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
    <template
        id="registration_complete"
        inherit_id="website_event.registration_complete"
    >
        <!-- remove time zone after dates and their enclosing brackets -->
        <wraptext
            expr="(//span[@t-out='event.date_tz'])[1]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[1]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext expr="(//span[@t-out='event.date_tz'])[1]" position="tail" />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[1]/following-sibling::t"
            position="replace"
        />
        <xpath expr="(//span[@t-out='event.date_tz'])[1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <wraptext
            expr="(//span[@t-out='event.date_tz'])[2]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[2]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext expr="(//span[@t-out='event.date_tz'])[2]" position="tail" />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[2]/following-sibling::t"
            position="replace"
        />
        <xpath expr="(//span[@t-out='event.date_tz'])[2]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
    <template
        id="registration_attendee_details"
        inherit_id="website_event.registration_attendee_details"
    >
        <div
            t-if="event.registration_multi_qty and ticket['quantity'] &gt; 1 and att_counter == 1"
            position="attributes"
        >
            <!-- never show checkbox to hide multiple tickets -->
            <attribute name="t-if">False</attribute>
        </div>
        <xpath expr="//div[@t-att-data-hide-multi-qty]" position="attributes">
            <!-- always hide boxes for multiple attendees if multi qty registration is enabled -->
            <attribute name="t-att-data-hide-multi-qty">None</attribute>
            <!-- prettier-ignore-start -->
            <attribute name="t-if">not event.registration_multi_qty or att_counter == 1</attribute>
            <!-- prettier-ignore-end -->
        </xpath>
        <xpath expr="//div[@t-att-data-hide-multi-qty]" position="after">
            <!-- generate input for ticket counting if multi qty registration is enabled -->
            <input
                class="d-none"
                t-if="event.registration_multi_qty and att_counter &gt; 1"
                type="text"
                t-attf-name="#{counter}-event_ticket_id"
                t-attf-value="#{ticket['id']}"
            />
        </xpath>
    </template>
</odoo>
