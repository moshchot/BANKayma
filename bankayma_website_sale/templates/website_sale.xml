<odoo>
    <template id="product" inherit_id="website_sale.product">
        <xpath expr="//a[@t-att-href='keep(category=0)']/.." position="after">
            <li t-if="product.bankayma_website_sale_company_id" class="breadcrumb-item">
                <a
                    t-if="product.bankayma_website_sale_company_id"
                    t-attf-href="{{product.sudo().bankayma_website_sale_company_id.website_link}}#store"
                    t-out="product.sudo().bankayma_website_sale_company_id.name"
                />
            </li>
        </xpath>
        <p t-field="product.description_sale" position="before">
            <p t-if="product.product_tag_ids" class="oe-product-tags">
                <span
                    t-foreach="product.product_tag_ids"
                    t-as="tag"
                    t-attf-class="o_tag o_tag_color_{{tag.color}} badge"
                >
                    <a t-att-href="keep(product_tag=tag.id)" t-field="tag.name" />
                </span>
            </p>
        </p>
    </template>
    <template id="products" inherit_id="website_sale.products">
        <t t-call="website_sale.search" position="before">
            <div class="dropdown ms-3">
                <a
                    t-attf-class="badge o_tag o_tag_color_{{product_tag.color}} me-2"
                    t-if="product_tag"
                    t-att-href="keep(product_tag=0)"
                >
                    <t t-out="product_tag.name" />
                    ×
                </a>
                <a
                    href="#"
                    role="button"
                    class="btn dropdown-toggle text-muted"
                    data-bs-toggle="dropdown"
                    data-display="static"
                >
                    Tag
                </a>
                <div
                    t-attf-class="dropdown-menu dropdown-menu-{{request.env['res.lang']._lang_get_direction(request.env.lang) == 'rtl' and 'end' or 'start'}}"
                >
                    <t
                        t-foreach="product_tags_available.filtered(lambda x: (project in x.product_template_ids.bankayma_website_sale_company_id) if project else True)"
                        t-as="tag"
                    >
                        <a
                            t-att-href="keep(product_tag=tag.id if tag != product_tag else None)"
                            t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if tag == product_tag else ''}"
                        >
                            <t t-out="tag.name" />
                        </a>
                    </t>
                </div>
            </div>
            <div class="dropdown ms-3 text-center" style="flex-grow: 2">
                <a
                    t-attf-class="badge o_tag me-2"
                    t-if="project"
                    t-att-href="keep(project=None)"
                >
                    <t t-out="project.name" />
                    ×
                </a>
                <a
                    href="#"
                    role="button"
                    class="btn dropdown-toggle text-muted"
                    data-bs-toggle="dropdown"
                    data-display="static"
                >
                    Project
                </a>
                <div
                    t-attf-class="dropdown-menu dropdown-menu-{{request.env['res.lang']._lang_get_direction(request.env.lang) == 'rtl' and 'end' or 'start'}}"
                >
                    <input
                        class="form-control mx-3 w-auto"
                        style=""
                        placeholder="Search..."
                        onkeyup="event.currentTarget.parentElement.querySelectorAll('a').forEach((a) => a.classList.toggle('d-none', event.currentTarget.value &amp;&amp; !a.innerText.toLowerCase().includes(event.currentTarget.value.toLowerCase())))"
                    />
                    <div style="max-height: 50vh; overflow-y: scroll;">
                        <t
                            t-foreach="product_tag.product_template_ids.bankayma_website_sale_company_id &amp; companies_available or companies_available"
                            t-as="company"
                        >
                            <a
                                t-att-href="keep(project=company.id if company.id != project.id else None)"
                                t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if company.id == project.id else ''}"
                                t-att-checked="'checked' if project.id == company.id else None"
                            >
                                <t t-out="company.name" />
                            </a>
                        </t>
                    </div>
                </div>
            </div>
        </t>
        <xpath expr="//div[hasclass('products_header')]" position="attributes">
            <attribute name="class" separator=" " add="container" />
            <attribute name="class" separator=" " remove="mb-3" />
        </xpath>
        <div id="wrap" position="before">
            <div class="bankayma_products_searchbar sticky-top pt16 pb16 o_cc o_cc4" />
        </div>
        <xpath expr="//div[hasclass('bankayma_products_searchbar')]" position="inside">
            <xpath expr="//div[hasclass('products_header')]" position="move" />
        </xpath>
    </template>
    <template id="products_item" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('oe_product_image')]" position="inside">
            <img
                t-if="product.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(product.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
    <template id="address" inherit_id="website_sale.address">
        <xpath expr="//input[@name='street']/.." position="before">
            <t
                t-set="address_required"
                t-value="website_sale_order._bankayma_checkout_address_required()"
            />
            <div class="alert alert-warning" t-if="not address_required">
                You have ordered services exclusively, so you do not need to fill in the
                address fields, but you can if you need them on your invoice.
            </div>
        </xpath>
        <label for="street" position="attributes">
            <attribute name="t-attf-class">
                col-form-label {{'label-optional' if not address_required else ''}}
            </attribute>
        </label>
        <label for="city" position="attributes">
            <attribute name="t-attf-class">
                col-form-label {{'label-optional' if not address_required else ''}}
            </attribute>
        </label>
        <label for="country_id" position="attributes">
            <attribute name="t-attf-class">
                col-form-label {{'label-optional' if not address_required else ''}}
            </attribute>
        </label>
    </template>
    <template
        id="dynamic_filter_template_product_product_add_to_cart"
        inherit_id="website_sale.dynamic_filter_template_product_product_add_to_cart"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(record.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_product_product_borderless_1"
        inherit_id="website_sale.dynamic_filter_template_product_product_borderless_1"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(record.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_product_product_borderless_2"
        inherit_id="website_sale.dynamic_filter_template_product_product_borderless_2"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(record.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
</odoo>
