<odoo>
    <template id="product" inherit_id="website_sale.product">
        <xpath expr="//a[@t-att-href='keep(category=0)']/.." position="after">
            <li t-if="product.bankayma_website_sale_company_id" class="breadcrumb-item">
                <a
                    t-if="product.bankayma_website_sale_company_id"
                    t-attf-href="{{product.sudo().bankayma_website_sale_company_id.website_link}}#store"
                    t-out="product.sudo().bankayma_website_sale_company_id.name"
                />
            </li>
        </xpath>
        <p t-field="product.description_sale" position="before">
            <p t-if="product.product_tag_ids" class="oe-product-tags">
                <span
                    t-foreach="product.product_tag_ids"
                    t-as="tag"
                    t-attf-class="o_tag o_tag_color_{{tag.color}} badge"
                >
                    <a t-att-href="keep(product_tag=tag.id)" t-field="tag.name" />
                </span>
            </p>
        </p>
    </template>
    <template id="products" inherit_id="website_sale.products">
        <t t-call="website_sale.pricelist_list" position="before">
            <div class="dropdown ms-3">
                <a
                    class="badge bg-o-color-1 me-2"
                    t-if="project"
                    t-att-href="keep(project=0)"
                >
                    <t t-out="project.name" />
                    ×
                </a>
                <select
                    class="btn o-select2"
                    t-attf-onchange="if (event.currentTarget.selectedOptions.length &amp;&amp; event.currentTarget.selectedOptions[0].attributes.href) window.location = event.currentTarget.selectedOptions[0].attributes.href.value"
                >
                    <option>Select project...</option>
                    <t t-foreach="companies_available" t-as="company">
                        <option
                            t-att-href="keep(project=company.id)"
                            t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if company.id == project.id else ''}"
                        >
                            <t t-out="company.name" />
                        </option>
                    </t>
                </select>
                <a
                    t-attf-class="badge o_tag o_tag_color_{{product_tag.color}} me-2"
                    t-if="product_tag"
                    t-att-href="keep(product_tag=0)"
                >
                    <t t-out="product_tag.name" />
                    ×
                </a>
                <a
                    href="#"
                    role="button"
                    class="btn dropdown-toggle"
                    data-bs-toggle="dropdown"
                >
                    Tag
                </a>
                <div class="dropdown-menu">
                    <t t-foreach="products.product_tag_ids" t-as="tag">
                        <a
                            t-att-href="keep(product_tag=tag.id)"
                            t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if False else ''}"
                        >
                            <t t-out="tag.name" />
                        </a>
                    </t>
                </div>
            </div>
        </t>
        <xpath expr="//div[hasclass('products_header')]" position="attributes">
            <attribute
                name="class"
                separator=" "
                add="sticky-top pt16 pb16 o_cc o_cc4"
            />
        </xpath>
        <div id="wrap" position="before">
            <xpath expr="//div[hasclass('products_header')]" position="move" />
        </div>
    </template>
    <template id="products_item" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('oe_product_image')]" position="inside">
            <img
                t-if="product.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(product.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_product_product_add_to_cart"
        inherit_id="website_sale.dynamic_filter_template_product_product_add_to_cart"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(record.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_product_product_borderless_1"
        inherit_id="website_sale.dynamic_filter_template_product_product_borderless_1"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(record.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_product_product_borderless_2"
        inherit_id="website_sale.dynamic_filter_template_product_product_borderless_2"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.bankayma_website_sale_company_id.logo"
                t-att-src="image_data_uri(record.bankayma_website_sale_company_id.with_context(bin_size=False).logo)"
                class="bk-company-logo-overlay bk-company-logo-overlay-right"
            />
        </xpath>
    </template>
</odoo>
