<odoo>
    <template id="product" inherit_id="website_sale.product">
        <a t-att-href="keep(category=0)" position="attributes">
            <attribute name="t-if">
                not product.bankayma_website_sale_company_id
            </attribute>
        </a>
        <a t-att-href="keep(category=0)" position="after">
            <a
                t-if="product.bankayma_website_sale_company_id"
                t-att-href="product.bankayma_website_sale_company_id.website_link"
                t-esc="product.bankayma_website_sale_company_id.name"
            />
        </a>
        <p t-field="product.description_sale" position="before">
            <p t-if="product.product_tag_ids" class="oe-product-tags">
                <span
                    t-foreach="product.product_tag_ids"
                    t-as="tag"
                    t-field="tag.name"
                    t-attf-class="o_tag o_tag_color_{{tag.color}} badge"
                />
            </p>
        </p>
    </template>
    <template id="products" inherit_id="website_sale.products">
        <t t-call="website_sale.pricelist_list" position="before">
            <div class="dropdown ms-3">
                <a
                    href="#"
                    role="button"
                    class="btn dropdown-toggle"
                    data-bs-toggle="dropdown"
                >
                    Project
                </a>
                <div class="dropdown-menu">
                    <t t-foreach="companies_available" t-as="company">
                        <a
                            t-att-href="keep(project=company.id)"
                            t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if company.id == project.id else ''}"
                        >
                            <t t-out="company.name" />
                        </a>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
