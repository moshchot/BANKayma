<odoo>
    <template id="product" inherit_id="website_sale.product">
        <xpath
            expr="//a[@t-att-href='keep(category=0, attribute_value=0, tags=0)']/.."
            position="after"
        >
            <li
                t-if="product.operating_unit_id"
                class="o_not_editable breadcrumb-item d-none d-lg-inline-block"
            >
                <a
                    t-attf-href="{{product.sudo().operating_unit_id.website_link}}#store"
                    t-out="product.sudo().operating_unit_id.name"
                />
            </li>
            <t t-call="website_sale.product_tags" position="inside">
                <t t-set="keep" t-value="keep" />
            </t>
        </xpath>
    </template>
    <template id="product_tags" inherit_id="website_sale.product_tags">
        <xpath expr="//t[@t-foreach]" position="inside">
            <!-- TODO: /website_sale/get_combination_info replaces this with a version that doesnt have keep -->
            <a t-att-href="keep and keep(tags=tag.id)" />
        </xpath>
        <xpath expr="//t[@t-foreach]/a" position="inside">
            <xpath expr="//t[@t-foreach]/t[@t-if]" position="move" />
        </xpath>
    </template>
    <template id="products" inherit_id="website_sale.products">
        <t t-call="website_sale.search" position="before">
            <div class="dropdown ms-3 text-center" style="flex-grow: 2">
                <a
                    t-attf-class="badge o_tag me-2"
                    t-if="project"
                    t-att-href="keep(project=None)"
                >
                    <t t-out="project.name" />
                    ×
                </a>
                <a
                    href="#"
                    role="button"
                    class="btn dropdown-toggle text-muted"
                    data-bs-toggle="dropdown"
                    data-display="static"
                    id="bk_project_dropdown"
                >
                    Project
                </a>
                <div
                    t-attf-class="dropdown-menu dropdown-menu-{{request.env['res.lang']._lang_get(request.env.lang).direction == 'rtl' and 'end' or 'start'}}"
                >
                    <input
                        class="form-control mx-3 w-auto"
                        style=""
                        placeholder="Search..."
                        onkeyup="event.currentTarget.parentElement.querySelectorAll('a').forEach((a) => a.classList.toggle('d-none', event.currentTarget.value &amp;&amp; !a.innerText.toLowerCase().includes(event.currentTarget.value.toLowerCase())))"
                    />
                    <div style="max-height: 50vh; overflow-y: scroll;">
                        <t
                            t-foreach="active_tags.product_template_ids.operating_unit_id &amp; operating_units_available or operating_units_available"
                            t-as="ou"
                        >
                            <a
                                t-att-href="keep(project=ou.id if ou.id != project.id else None)"
                                t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if ou.id == project.id else ''}"
                                t-att-checked="'checked' if project.id == ou.id else None"
                            >
                                <t t-out="ou.name" />
                            </a>
                        </t>
                    </div>
                </div>
            </div>
        </t>
        <xpath expr="//div[hasclass('products_header')]" position="attributes">
            <attribute name="class" separator=" " add="container" />
            <attribute name="class" separator=" " remove="mb-3" />
        </xpath>
        <div id="wrap" position="before">
            <div class="bankayma_products_searchbar sticky-top pt16 pb16 o_cc o_cc4" />
        </div>
        <xpath expr="//div[hasclass('bankayma_products_searchbar')]" position="inside">
            <xpath expr="//div[hasclass('products_header')]" position="move" />
        </xpath>
    </template>
    <template id="products_item" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('oe_product_image')]" position="inside">
            <img
                t-if="product.operating_unit_id.logo"
                t-att-src="image_data_uri(product.operating_unit_id.with_context(bin_size=False).logo)"
                class="bk-logo-overlay bk-logo-overlay-right"
            />
        </xpath>
    </template>
    <template id="address" inherit_id="website_sale.address">
        <xpath expr="//input[@name='street']/.." position="before">
            <t
                t-set="address_required"
                t-value="website_sale_order._bankayma_checkout_address_required()"
            />
            <div class="alert alert-warning" t-if="not address_required">
                You have ordered services exclusively, so you do not need to fill in the
                address fields, but you can if you need them on your invoice.
            </div>
        </xpath>
        <label for="o_street" position="attributes">
            <attribute name="t-attf-class">
                col-form-label {{'label-optional' if not address_required else ''}}
            </attribute>
        </label>
        <label for="o_city" position="attributes">
            <attribute name="t-attf-class">
                col-form-label {{'label-optional' if not address_required else ''}}
            </attribute>
        </label>
        <label for="o_country_id" position="attributes">
            <attribute name="t-attf-class">
                col-form-label {{'label-optional' if not address_required else ''}}
            </attribute>
        </label>
    </template>
    <template
        id="dynamic_filter_template_product_product_add_to_cart"
        inherit_id="website_sale.dynamic_filter_template_product_product_add_to_cart"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.operating_unit_id.logo"
                t-att-src="image_data_uri(record.operating_unit_id.with_context(bin_size=False).logo)"
                class="bk-logo-overlay bk-logo-overlay-right"
            />
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_product_product_borderless_1"
        inherit_id="website_sale.dynamic_filter_template_product_product_borderless_1"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.operating_unit_id.logo"
                t-att-src="image_data_uri(record.operating_unit_id.with_context(bin_size=False).logo)"
                class="bk-logo-overlay bk-logo-overlay-right"
            />
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_product_product_borderless_2"
        inherit_id="website_sale.dynamic_filter_template_product_product_borderless_2"
    >
        <xpath expr="//a[hasclass('o_carousel_product_img_link')]" position="inside">
            <img
                t-if="record.operating_unit_id.logo"
                t-att-src="image_data_uri(record.operating_unit_id.with_context(bin_size=False).logo)"
                class="bk-logo-overlay bk-logo-overlay-right"
            />
        </xpath>
    </template>
</odoo>
