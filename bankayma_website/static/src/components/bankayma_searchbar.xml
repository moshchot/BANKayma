<templates>
    <div
        t-name="bankayma_searchbar.badge"
        class="badge bg-o-color-1 me-2"
        t-att-data-search-field="field"
        t-att-data-search-value="value"
    >
        <t t-esc="name" />
    </div>
    <t t-name="bankayma_searchbar.suggestions">
        <button class="d-none" data-bs-toggle="dropdown" data-bs-reference="parent" />
        <ul class="dropdown-menu w-100">
            <li
                t-foreach="suggestions"
                t-as="suggestion"
                class="dropdown-item"
                t-att-data-search-field="suggestion.field"
                t-att-data-search-value="suggestion.value"
                t-key="suggestion.value || suggestion.url"
            >
                <a t-att-href="suggestion.url" t-esc="suggestion.name" />
            </li>
        </ul>
    </t>
</templates>
