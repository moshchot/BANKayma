<odoo>
    <record id="view_bankayma_project_page_embed_code_form" model="ir.ui.view">
        <field name="model">bankayma.project.page.embed.code</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" invisible="True" />
                    <group>
                        <field name="options" widget="many2many_checkboxes" />
                    </group>
                    <group>
                        <field name="embed_code" />
                    </group>
                </group>
                <label for="embed_code_html" />
                <field name="embed_code_html" />
            </form>
        </field>
    </record>
    <record id="action_bankayma_project_page_embed_code" model="ir.actions.act_window">
        <field name="name">Embed code</field>
        <field name="res_model">bankayma.project.page.embed.code</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="base.model_res_company" />
        <field name="context">{'default_company_id': context.get('active_id')}</field>
        <field name="target">new</field>
    </record>
</odoo>
