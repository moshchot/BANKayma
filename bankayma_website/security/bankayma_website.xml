<odoo>
    <record id="group_website" model="res.groups">
        <field name="name">Website Manager</field>
        <field name="category_id" ref="bankayma_base.category" />
        <field name="comment" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('base.group_user')), Command.link(ref('website.group_website_restricted_editor')), Command.link(ref('event.group_event_manager'))]"
        />
    </record>
    <record id="rule_blog_post" model="ir.rule">
        <field name="name">Blog post multicompany</field>
        <field name="model_id" ref="website_blog.model_blog_post" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
