<odoo>
    <record id="group_website" model="res.groups">
        <field name="name">Website Manager</field>
        <field name="category_id" ref="bankayma_base.category" />
        <field name="comment" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('bankayma_base.group_user')), Command.link(ref('website.group_website_restricted_editor')), Command.link(ref('event.group_event_user')), Command.link(ref('base.group_partner_manager'))]"
        />
    </record>

    <record id="base.default_user" model="res.users">
        <field
            name="groups_id"
            eval="[Command.unlink(ref('event.group_event_manager'))]"
        />
    </record>
</odoo>
