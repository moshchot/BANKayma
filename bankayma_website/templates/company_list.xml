<odoo>
    <template id="company_list_tags">
        <ul t-att-class="'nav' if not tags.parent_id else 'dropdown-menu'">
            <li
                t-foreach="tags"
                t-as="tag"
                t-attf-class="nav-item {{'dropdown' if tag.child_ids else None}}"
            >
                <a
                    t-att-data-search-field="'tags' if not tag.child_ids else None"
                    t-att-data-search-value="tag.id"
                    t-attf-class="nav-link {{'dropdown-toggle' if tag.child_ids else None}} {{'ps-0' if tag.child_ids and tag_index == 0 else None}}"
                    t-att-data-bs-toggle="'dropdown' if tag.child_ids else None"
                    t-esc="tag.name"
                    data-bs-auto-close="outside"
                    href="#"
                />
                <t t-if="tag.child_ids" t-call="bankayma_website.company_list_tags">
                    <t t-set="tags" t-value="tag.child_ids" />
                </t>
            </li>
        </ul>
    </template>
    <template id="company_list" name="Company list">
        <t t-call="website.layout">
            <section class="bankayma_projects_searchbar sticky-top bg-body">
                <div class="o_container_small">
                    <div class="navbar px-0">
                        <t t-call="bankayma_website.company_list_tags">
                            <t
                                t-set="tags"
                                t-value="objects.env['res.company.tag'].search([('parent_id', '=', False)])"
                            />
                        </t>
                        <form
                            class="d-flex flex-grow-1"
                            role="search"
                            method="post"
                            action="/projects"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />
                            <input
                                type="hidden"
                                class="badge"
                                name="tags"
                                t-att-value="tags"
                            />
                            <div class="input-group">
                                <input
                                    type="search"
                                    name="search"
                                    autocomplete="off"
                                    class="form-control oe_search_box"
                                    placeholder="search..."
                                    t-att-value="search"
                                />
                                <button
                                    class="btn btn-primary oe_search_button"
                                    type="submit"
                                >
                                    <i class="oi oi-search" />
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
            <section
                t-attf-class="s_three_columns o_colored_level o_cc o_cc1 pt0 pb16 {{'d-none' if not objects else None}}"
            >
                <div class="o_container_small">
                    <div class="row d-flex align-items-stretch">
                        <div
                            class="col-lg-4 s_col_no_bgcolor pt16 pb4"
                            t-foreach="objects"
                            t-as="object"
                        >
                            <div
                                class="card text-bg-white h-100"
                                style="border-style: double !important; border-color: rgb(4, 159, 123) !important;"
                            >
                                <img
                                    t-att-src="image_data_uri(object.logo)"
                                    t-att-alt="object.name"
                                    class="card-img-top img img-fluid o_we_custom_image mx-auto d-block rounded-circle"
                                    style="width: 50% !important;"
                                    loading="lazy"
                                    t-if="object.logo"
                                />
                                <div class="card-body">
                                    <h3 class="card-title" style="text-align: center;">
                                        <span style="font-size: 24px;">
                                            <b>
                                                <a
                                                    t-att-href="object.website_link"
                                                    t-out="object.name"
                                                />
                                            </b>
                                        </span>
                                    </h3>
                                    <h4
                                        style="text-align: center;"
                                        t-if="object.bankayma_website_subtitle"
                                    >
                                        <span
                                            style="font-size: 18px;"
                                            t-out="object.bankayma_website_subtitle"
                                        />
                                    </h4>
                                    <div class="o_container_small">
                                        <a
                                            t-foreach="object.tag_ids"
                                            t-as="company_tag"
                                            t-attf-href="/projects?tags={{company_tag.id}}"
                                        >
                                            <span
                                                class="s_badge badge text-bg-secondary o_animable bg-o-color-1"
                                                t-out="company_tag.name"
                                            />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section t-att-class="'d-none' if objects else None">
                <div class="o_container_small">No results found</div>
            </section>
        </t>
    </template>
</odoo>
