<odoo>
    <template id="bankayma_searchbar_tags">
        <ul t-att-class="'nav' if not tags.parent_id else 'dropdown-menu'">
            <li
                t-foreach="tags"
                t-as="tag"
                t-attf-class="nav-item {{'dropdown' if tag.child_ids else None}}"
            >
                <a
                    t-att-data-search-field="'tags' if not tag.child_ids else None"
                    t-att-data-search-value="tag.id"
                    t-attf-class="nav-link {{'dropdown-toggle' if tag.child_ids else None}} {{'ps-0' if tag.child_ids and tag_index == 0 else None}}"
                    t-att-data-bs-toggle="'dropdown' if tag.child_ids else None"
                    t-esc="tag.name"
                    data-bs-auto-close="outside"
                    href="#"
                />
                <t
                    t-if="tag.child_ids"
                    t-call="bankayma_website.bankayma_searchbar_tags"
                >
                    <t t-set="tags" t-value="tag.child_ids" />
                </t>
            </li>
        </ul>
    </template>
    <template id="bankayma_searchbar">
        <section class="bankayma_searchbar sticky-top pt16 pb16 o_cc o_cc4">
            <div class="o_container_small">
                <div class="navbar px-0">
                    <t t-foreach="config['badges']" t-as="badge">
                        <t t-call="bankayma_website.bankayma_searchbar_tags">
                            <t t-set="tags" t-value="config['badges'][badge]" />
                        </t>
                    </t>
                    <form
                        class="d-flex flex-grow-1"
                        role="search"
                        method="post"
                        t-att-action="config['action']"
                        t-att-data-suggestion-route="config['suggestions']"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <t t-foreach="config['badges']" t-as="badge">
                            <input
                                type="hidden"
                                class="badge"
                                t-att-name="badge"
                                t-att-value="post_data[badge]"
                            />
                        </t>
                        <div class="input-group">
                            <input
                                type="search"
                                name="search"
                                autocomplete="off"
                                class="form-control oe_search_box"
                                placeholder="search..."
                                t-att-value="search"
                            />
                            <button
                                class="btn btn-primary oe_search_button"
                                type="submit"
                            >
                                <i class="oi oi-search" />
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </template>
    <template id="company_list" name="Company list">
        <t t-call="website.layout">
            <t t-call="bankayma_website.bankayma_searchbar">
                <t
                    t-set="config"
                    t-value="{'action': '/projects', 'suggestions': '/projects/search', 'badges': {'tags': objects.env['res.company.tag'].search([('parent_id', '=', False)])}}"
                />
            </t>
            <section
                id="results"
                t-attf-class="s_features_grid o_colored_level pb0 pt32 {{'d-none' if not objects else None}}"
            >
                <div class="container justify-content-around">
                    <div class="row d-flex align-items-stretch">
                        <div
                            class="s_col_no_bgcolor pb24 col-lg-4"
                            t-foreach="objects"
                            t-as="object"
                        >
                            <div
                                class="col-lg-12 pt16 pb16 o_colored_level border rounded d-flex flex-row align-items-center"
                                data-name="Box"
                                style="min-height:150px; border-color: rgb(233, 236, 239) !important; border-radius: 50px !important;"
                            >
                                <img
                                    t-att-src="image_data_uri(object.logo)"
                                    t-att-alt="object.name"
                                    class="s_features_grid_icon img img-fluid o_we_custom_image ml16"
                                    style="width: 25% !important;"
                                    loading="lazy"
                                    t-if="object.logo"
                                />
                                <div class="s_features_grid_content">
                                    <h4 class="card-title" style="">
                                        <span style="font-size: 24px;">
                                            <b>
                                                <a
                                                    t-att-href="object.website_link"
                                                    t-out="object.name"
                                                />
                                            </b>
                                        </span>
                                    </h4>
                                    <h4
                                        style=""
                                        t-if="object.bankayma_website_subtitle"
                                    >
                                        <span
                                            style="font-size: 18px;"
                                            t-out="object.bankayma_website_subtitle"
                                        />
                                    </h4>
                                    <div class="container justify-content-around">
                                        <a
                                            t-foreach="object.tag_ids"
                                            t-as="company_tag"
                                            t-attf-href="/projects?tags={{company_tag.id}}"
                                        >
                                            <span
                                                class="s_badge badge text-bg-secondary o_animable bg-o-color-1"
                                                t-out="company_tag.name"
                                            />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section t-att-class="'d-none' if objects else None">
                <div class="o_container_small">No results found</div>
            </section>
        </t>
    </template>
</odoo>
