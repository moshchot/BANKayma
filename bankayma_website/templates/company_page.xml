<odoo>
    <template id="company_page" name="Company page">
        <t t-set="title" t-value="object.name" />
        <t t-call="website.layout">
            <t
                t-set="events"
                t-value="request.env['event.event'].search([('is_published', '=', True), ('company_id', '=', object.id)])"
            />
            <t
                t-set="blog_posts"
                t-value="request.env['blog.post'].search([('company_id', '=', object.id), ('is_published', '=', True)], limit=5)"
            />
            <div id="wrap" class="oe_structure oe_empty">
                <section
                    class="s_parallax parallax s_parallax_is_fixed bg-black-50 o_colored_level o_half_screen_height pb0 pt0"
                    data-scroll-background-ratio="1"
                    data-snippet="s_parallax"
                    data-name="Parallax"
                    style="background-image: none;"
                >
                    <span
                        class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box"
                        t-attf-style="background-image: url({{image_data_uri(object.bankayma_website_cover or object.logo)}})"
                        t-if="object.bankayma_website_cover or object.logo"
                        data-mimetype="image/jpeg"
                        data-resize-width="1920"
                    />
                    <section
                        class="s_features_grid o_colored_level pb0 pt32 s_custom_snippet"
                        data-snippet="s_features_grid"
                        data-name="company blocks"
                        style="background-image: none;"
                    >
                        <div class="container">
                            <div class="row">
                                <div class="s_col_no_bgcolor pb24 col-lg-4">
                                    <div class="row">
                                        <div
                                            class="pt16 pb16 o_colored_level border rounded o_cc o_cc1 col-lg-12"
                                            data-name="Box"
                                            style="border-color: rgb(233, 236, 239) !important; border-radius: 50px !important;"
                                        >
                                            <img
                                                t-att-src="image_data_uri(object.logo)"
                                                alt=" "
                                                class="s_features_grid_icon img img-fluid o_we_custom_image"
                                                style="width: 25% !important;"
                                                loading="lazy"
                                            />
                                            <div class="s_features_grid_content">
                                                <h2>
                                                    <strong t-out="object.name" />
                                                </h2>
                                                <h6>
                                                    <span
                                                        style="font-size: 16px;"
                                                        t-field="object.bankayma_website_subtitle"
                                                    />
                                                </h6>
                                                <h6>
                                                    <span
                                                        style="font-size: 16px;"
                                                        t-if="object.street or object.city"
                                                    >
                                                        <span
                                                            class="text-200 bg-o-color-2"
                                                            style="font-style: normal; font-weight: 400;"
                                                        >
                                                            כתובת: 
                                                        </span>
                                                        <span t-field="object.street" />
                                                        ,
                                                        
                                                        <span t-field="object.city" />
                                                    </span>
                                                </h6>
                                                <h6>
                                                    <span
                                                        style="font-size: 16px;"
                                                        t-if="object.bankayma_website_opening_hours"
                                                    >
                                                        <span
                                                            t-field="object.bankayma_website_opening_hours"
                                                        />
                                                        שעות פתיחה:
                                                    </span>
                                                    <br />
                                                </h6>
                                                <div
                                                    class="container justify-content-around"
                                                >
                                                    <a
                                                        t-foreach="object.tag_ids"
                                                        t-as="company_tag"
                                                        t-attf-href="/projects?tags={{company_tag.id}}"
                                                    >
                                                        <span
                                                            class="s_badge badge text-bg-secondary o_animable bg-o-color-1"
                                                            t-out="company_tag.name"
                                                        />
                                                    </a>
                                                </div>
                                                <h6>
                                                    <div
                                                        class="s_social_media text-start o_not_editable"
                                                        data-snippet="s_social_media"
                                                    >
                                                        <h4
                                                            class="s_social_media_title o_default_snippet_text d-none"
                                                        >
                                                            Social Networks
                                                        </h4>
                                                        <a
                                                            t-if="object.social_twitter"
                                                            t-att-href="object.social_twitter"
                                                            class="s_social_media_twitter"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-twitter rounded-circle shadow-sm"
                                                            />
                                                        </a>
                                                        <a
                                                            t-if="object.social_facebook"
                                                            t-att-href="object.social_facebook"
                                                            class="s_social_media_facebook"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-facebook rounded-circle shadow-sm"
                                                            />
                                                        </a>
                                                        <a
                                                            t-if="object.social_instagram"
                                                            t-att-href="object.social_instagram"
                                                            class="s_social_media_instagram"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-instagram rounded-circle shadow-sm"
                                                            />
                                                        </a>
                                                        <a
                                                            t-if="object.social_youtube"
                                                            t-att-href="object.social_youtube"
                                                            class="s_social_media_youtube"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-youtube rounded-circle shadow-sm"
                                                            />
                                                        </a>
                                                    </div>
                                                </h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </section>
                <section
                    class="s_text_block o_colored_level pt0 pb0 o_cc o_cc4"
                    style="background-image: none;"
                >
                    <div class="s_allow_columns container-fluid">
                        <div class="row" style="">
                            <div
                                class="o_colored_level col-lg-12 o_cc o_cc2"
                                style="text-align: center;"
                            >
                                <span class="s_badge badge o_animable bg-white-25">
                                    <a href="#about">
                                        <i
                                            class="fa fa-info fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            about
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge o_animable bg-white-25"
                                    t-if="blog_posts"
                                >
                                    <a href="#updates">
                                        <i
                                            class="fa fa-bullhorn fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            updates
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge o_animable bg-white-25"
                                    t-if="object.bankayma_website_videolink"
                                >
                                    <a href="#media">
                                        <i
                                            class="fa fa-photo fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            media
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge o_animable bg-white-25"
                                    t-if="events"
                                >
                                    <a href="#events">
                                        <i
                                            class="fa fa-calendar-check-o fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            events
                                        </span>
                                    </a>
                                </span>
                                <span class="s_badge badge o_animable bg-white-25">
                                    <a href="#donation">
                                        <i
                                            class="fa fa-gittip fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            donation
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge o_animable bg-white-25"
                                    t-if="object.bankayma_website_crew_partner_ids"
                                >
                                    <a href="#team">
                                        <i
                                            class="fa fa-user fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            crew
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge o_animable bg-white-25"
                                    t-if="object.bankayma_website_backer_partner_ids"
                                >
                                    <a href="#backers">
                                        <i
                                            class="fa fa-user-circle-o fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            backers
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge text-bg-secondary o_animable bg-white-25"
                                >
                                    <a href="#contact">
                                        <i
                                            class="fa fa-phone fa-fw o_not-animable mx-auto d-block fa-2x"
                                        />
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            contact
                                        </span>
                                    </a>
                                </span>
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_text_block o_colored_level pb0 pt0"
                    style="background-image: none;"
                    id="about"
                >
                    <div class="s_allow_columns container-fluid">
                        <div class="s_allow_columns container-fluid">
                            <div class="row">
                                <div
                                    data-scroll-zone-end="65"
                                    data-scroll-zone-start="0"
                                    style="animation-delay: -0.249621s;"
                                    class="o_colored_level o_anim_fade_in o_animate o_animate_on_scroll pb40 pt40 col-lg-12 o_cc o_cc3"
                                >
                                    <p t-out="object.website_description" />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_text_block pt40 pb40 o_colored_level o_cc o_cc4"
                    style="background-image: none;"
                    id="updates"
                    t-if="blog_posts"
                >
                    <div class="s_allow_columns container-fluid">
                        <p style="text-align: center;">
                            <span
                                class="s_badge badge bg-o-color-3 text-o-color-1 o_animable"
                                data-name="תג"
                                data-snippet="s_badge"
                                style="font-size: 36px;"
                            >
                                <i
                                    class="fa fa-bullhorn fa-fw o_not-animable mx-auto d-block fa-2x"
                                />
                                <span>updates</span>
                            </span>
                        </p>
                        <h4 t-foreach="blog_posts" t-as="blog_post">
                            <span
                                class="o_animated_text o_animate o_anim_slide_in o_anim_from_right o_visible"
                                t-attf-style="animation-delay: {{blog_post_index + 1}}s;"
                            >
                                <a t-att-href="blog_post.website_url">
                                    <strong t-out="blog_post.name" />
                                    :
                                    <t t-out="blog_post.teaser" />
                                </a>
                            </span>
                        </h4>
                    </div>
                </section>
                <section
                    class="o_colored_level parallax"
                    style="background-image: none;"
                    id="media"
                    t-if="object.bankayma_website_videolink"
                >
                    <div class="container-fluid">
                        <div class="row" data-row-count="6">
                            <div
                                class="text-center o_colored_level o_anim_fade_in o_animate o_visible g-height-6 g-col-lg-12 col-lg-12"
                                data-name="Block"
                                style="z-index: 5; background-image: none;"
                            >
                                <div class="mx-auto media_iframe_video s_parallax_bg">
                                    <div class="media_iframe_video_size" />
                                    <iframe
                                        t-att-src="object.bankayma_website_videolink_embed"
                                        frameborder="0"
                                        allowfullscreen="allowfullscreen"
                                        marginheight="0"
                                        marginwidth="0"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_image_gallery pt24 o_colored_level o_slideshow s_image_gallery_indicators_arrows_boxed s_image_gallery_show_indicators s_image_gallery_indicators_dots o_cc o_cc3"
                    data-vcss="001"
                    data-columns="3"
                    style="overflow: hidden; height: 662px; background-image: none;"
                    data-snippet="s_image_gallery"
                    data-name="Image Gallery"
                    t-if="object.bankayma_website_image_ids"
                >
                    <div class="container">
                        <div
                            id="slideshow_1725973766980"
                            class="carousel slide"
                            data-bs-ride="carousel"
                            data-bs-interval="0"
                            style="margin: 0 12px;"
                        >
                            <div class="carousel-inner" style="padding: 0;">
                                <div
                                    t-attf-class="carousel-item {{'active' if image_index == 0 else ''}}"
                                    style=""
                                    t-foreach="object.bankayma_website_image_ids"
                                    t-as="image"
                                >
                                    <img
                                        t-att-src="image_data_uri(image.datas)"
                                        alt=""
                                        class="img img-fluid d-block o_we_custom_image shadow"
                                        loading="lazy"
                                        style=""
                                        t-attf-data-index="{{image_index}}"
                                    />
                                </div>
                            </div>

                            <ul class="carousel-indicators" style="">
                                <li
                                    class="o_indicators_left text-center d-none"
                                    aria-label="קודם"
                                    title="קודם"
                                >
                                    <i class="fa fa-chevron-left" />
                                </li>

                                <li
                                    t-foreach="object.bankayma_website_image_ids"
                                    t-as="image"
                                    data-bs-target="#slideshow_1725973766980"
                                    t-attf-data-bs-slide-to="{{image_index}}"
                                    t-attf-style="background-image: url({{image_data_uri(image.datas)}})"
                                    t-att-aria-current="'true' if image_index == 0 else None"
                                    t-att-class="'active' if image_index == 0 else None"
                                />
                                <li
                                    class="o_indicators_right text-center d-none"
                                    aria-label="הבא"
                                    title="הבא"
                                >
                                    <i class="fa fa-chevron-right" />
                                </li>
                            </ul>
                            <a
                                class="carousel-control-prev o_we_no_overlay o_not_editable"
                                href="#slideshow_1725973766980"
                                data-bs-slide="prev"
                                aria-label="קודם"
                                title="קודם"
                            >
                                <span class="fa fa-chevron-left fa-2x text-white" />
                                <span class="visually-hidden">קודם</span>
                            </a>
                            <a
                                class="carousel-control-next o_we_no_overlay o_not_editable"
                                href="#slideshow_1725973766980"
                                data-bs-slide="next"
                                aria-label="הבא"
                                title="הבא"
                            >
                                <span class="fa fa-chevron-right fa-2x text-white" />
                                <span class="visually-hidden">הבא</span>
                            </a>
                        </div>
                    </div>
                </section>
                <section data-snippet="s_image_gallery" position="after">
                    <section
                        class="s_title pt40 pb40 o_colored_level"
                        style="background-image: none;"
                        id="events"
                        t-if="events"
                    >
                        <div
                            class="container s_allow_columns s_dynamic s_event_event_card"
                        >
                            <h2 style="text-align: center;">
                                <strong>events</strong>
                            </h2>
                            <t
                                t-out="render_dynamic_snippet('website_event.dynamic_filter_template_event_event_card', events)"
                            />
                        </div>
                    </section>
                </section>
                <section
                    class="pt32 pb32 o_colored_level o_cc o_cc2"
                    style="background-image: none;"
                    id="donation"
                    data-anchor="true"
                    dir="ltr"
                >
                    <div class="o_container_small">
                        <h2 style="text-align: center;">
                            <strong>donation</strong>
                        </h2>
                        <div class="row" style="">
                            <div class="o_colored_level col-lg-12" style="">
                                <div
                                    class="s_donation"
                                    data-name="Donation Button"
                                    t-att-data-donation-email="object.email"
                                    data-custom-amount="slider"
                                    data-prefilled-options=""
                                    data-descriptions=""
                                    data-minimum-amount="5"
                                    data-maximum-amount="1000"
                                    data-slider-step="10"
                                    data-default-amount="30"
                                    data-snippet="s_donation_button"
                                >
                                    <form
                                        class="s_donation_form"
                                        t-attf-action="/donation/pay?company_id={{object.id}}"
                                        method="post"
                                        enctype="multipart/form-data"
                                        style="text-align: center;"
                                    >
                                        <div
                                            class="s_donation_range_slider_wrap mb-2 position-relative"
                                        >
                                            <input
                                                name="amount"
                                                type="range"
                                                class="form-range"
                                                min="5"
                                                max="1000"
                                                step="10"
                                                id="s_donation_range_slider"
                                            />
                                            <output
                                                class="s_range_bubble"
                                                style="left: calc(3.01508% + 7.51759px);"
                                            >
                                                35
                                            </output>
                                        </div>
                                        <a
                                            href="#"
                                            type="button"
                                            class="s_donation_donate_btn btn btn-secondary btn-lg mb-2 o_default_snippet_text"
                                        >
                                            Donate Now
                                        </a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_company_team o_colored_level pt24 pb32 o_cc o_cc3"
                    style="background-image: none;"
                    id="team"
                    t-if="object.bankayma_website_crew_partner_ids"
                >
                    <div class="container-fluid">
                        <div class="row s_nb_column_fixed" style="">
                            <div class="o_colored_level col-lg-12" style="">
                                <p style="text-align: center;">
                                    <span style="font-size: 36px;">
                                        <strong>our crew</strong>
                                    </span>
                                </p>
                            </div>
                            <div
                                class="o_colored_level o_anim_fade_in o_animate o_animate_on_scroll col-lg-3"
                                style="animation-delay: 0.0107189s;"
                                data-scroll-zone-start="0"
                                data-scroll-zone-end="65"
                                t-foreach="object.bankayma_website_crew_partner_ids"
                                t-as="partner"
                            >
                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                    <div class="col-lg-4 pb16 o_not_editable">
                                        <img
                                            t-att-alt="partner.name"
                                            t-att-src="image_data_uri(partner.avatar_128)"
                                            class="img-fluid rounded-circle mx-auto o_editable_media"
                                            loading="eager"
                                            t-if="partner.avatar_128"
                                        />
                                    </div>
                                    <div class="col-lg-8">
                                        <h4
                                            style="text-align: center;"
                                            t-out="partner.name"
                                        />
                                        <p t-out="partner.function" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_references o_colored_level pb32 pt24 o_cc o_cc1"
                    id="backers"
                    t-if="object.bankayma_website_backer_partner_ids"
                >
                    <div class="container">
                        <h5 style="text-align: center;">
                            <span style="font-size: 36px;">
                                <strong>backers</strong>
                            </span>
                        </h5>
                        <div class="row">
                            <div
                                class="col-lg-2 pt16 pb16 o_colored_level"
                                t-foreach="object.bankayma_website_backer_partner_ids"
                                t-as="partner"
                            >
                                <img
                                    t-att-alt="partner.name"
                                    t-att-src="image_data_uri(partner.avatar_128)"
                                    class="img img-fluid mx-auto"
                                    loading="lazy"
                                    t-if="partner.avatar_128"
                                />
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_map pb56 pt56"
                    data-map-type="m"
                    data-map-zoom="15"
                    data-snippet="s_map"
                    t-attf-data-map-address="{{object.street}} {{object.city}}"
                    id="map"
                    t-if="object.bankayma_website_geolink"
                >
                    <div class="map_container o_not_editable">
                        <iframe
                            class="s_map_embedded o_not_editable"
                            width="100%"
                            height="100%"
                            frameborder="0"
                            scrolling="no"
                            marginheight="0"
                            marginwidth="0"
                            t-att-src="object.bankayma_website_geolink"
                        />
                        <div class="s_map_color_filter" style="" />
                    </div>
                </section>
                <section
                    class="s_text_block o_colored_level pb0 pt0 o_cc o_cc3"
                    style="background-image: none;"
                    id="contact"
                >
                    <div class="s_allow_columns container">
                        <h4 class="text-center mb-1" style="text-align: right;">
                            <span style="font-size: 16px;">
                                <a title="" data-bs-original-title="" href="/about">
                                    <span style="font-size: 16px;" />
                                </a>
                            </span>
                            <span
                                style="font-size: 18px;"
                            >&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;
                                <strong
                                    t-field="object.partner_id"
                                    t-options='{"widget": "contact"}'
                                />
                            </span>
                        </h4>
                        <h4
                            class="text-center mb-1"
                            style="text-align: right;"
                            t-if="object.bankayma_website_opening_hours"
                        >
                            <span t-field="object.bankayma_website_opening_hours" />
                        </h4>
                        <h4 class="text-center mb-1" style="text-align: right;">
                            <span
                                style="font-size: 18px;"
                            >&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp; 02-1234567&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;<strong
                                    t-out="object.phone"
                                /> &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;</span>
                            <span
                                style="font-size: 18px;"
                            >&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp; 02-1234567&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;<a
                                    t-att-href="object.website"
                                    t-out="object.website"
                                /> &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;</span>
                            <span style="font-size: 18px;">
                                <a t-att-href="object.email" t-out="object.email" />
                            </span>
                        </h4>
