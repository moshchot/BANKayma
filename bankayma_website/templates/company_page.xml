<odoo>
    <template id="company_page" name="Company page">
        <t t-set="title" t-value="object.name" />
        <t t-call="website.layout">
            <t
                t-set="blog_posts"
                t-value="request.env['blog.post'].search([('company_id', '=', object.id), ('is_published', '=', True)], limit=3)"
            />
            <div id="wrap">
                <ol class="breadcrumb mb-0 py-2">
                    <li class="breadcrumb-item ms-1">
                        <a href="/projects">All Projects</a>
                    </li>
                    <li class="breadcrumb-item ms-1" t-if="object.tag_ids.parent_id">
                        <a
                            t-attf-href="/projects?tags={{','.join(map(str, object.tag_ids.parent_id[:1].child_ids.ids))}}"
                            t-out="object.tag_ids.parent_id[:1].name"
                        />
                    </li>
                    <li class="breadcrumb-item ms-1">
                        <a t-att-href="object.website_link" t-out="object.name" />
                    </li>
                </ol>
                <section
                    class="s_parallax parallax s_parallax_is_fixed bg-black-50 o_colored_level o_half_screen_height pb0 pt0"
                    data-scroll-background-ratio="1"
                    data-snippet="s_parallax"
                    data-name="Parallax"
                    style="background-image: none;"
                >
                    <span
                        class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box"
                        t-attf-style="background-image: url({{image_data_uri(object.bankayma_website_cover or object.logo)}})"
                        t-if="object.bankayma_website_cover or object.logo"
                        data-mimetype="image/jpeg"
                        data-resize-width="1920"
                    />
                    <section
                        class="s_features_grid o_colored_level pb0 pt32 s_custom_snippet"
                        data-snippet="s_features_grid"
                        data-name="company cover"
                        style="background-image: none;"
                    >
                        <div class="container">
                            <div class="row">
                                <div class="s_col_no_bgcolor pb24 col-lg-4">
                                    <div class="row">
                                        <div
                                            class="pt16 pb16 o_colored_level border rounded o_cc o_cc1 col-lg-12"
                                            data-name="Box"
                                            style="border-color: rgb(233, 236, 239) !important; border-radius: 50px !important;"
                                        >
                                            <img
                                                t-if="object.logo"
                                                t-att-src="image_data_uri(object.logo)"
                                                alt=" "
                                                class="s_features_grid_icon img img-fluid o_we_custom_image"
                                                style="width: 25% !important;"
                                                loading="lazy"
                                            />
                                            <div class="s_features_grid_content">
                                                <h2>
                                                    <t t-out="object.name" />
                                                </h2>
                                                <h6>
                                                    <span
                                                        style="font-size: 16px;"
                                                        t-field="object.bankayma_website_subtitle"
                                                    />
                                                </h6>
                                                <h6>
                                                    <span
                                                        style="font-size: 16px;"
                                                        t-if="object.street or object.city"
                                                    >
                                                        <span
                                                            class="text-200"
                                                            style="font-style: normal; font-weight: 400;"
                                                        >
                                                            Address:&amp;nbsp;&amp;nbsp;
                                                        </span>
                                                        <!-- prettier-ignore-start -->
                                                        <span t-field="object.street" /><span t-if="object.city">, </span>
                                                        <!-- prettier-ignore-end -->
                                                        <span t-field="object.city" />
                                                    </span>
                                                </h6>
                                                <h6>
                                                    <span
                                                        style="font-size: 16px;"
                                                        t-if="object.bankayma_website_opening_hours"
                                                    >
                                                        <span
                                                            class="text-200"
                                                            style="font-style: normal; font-weight: 400;"
                                                        >
                                                            Opening Hours:
                                                        </span>
                                                        <span
                                                            class="ms-2"
                                                            t-field="object.bankayma_website_opening_hours"
                                                        />
                                                    </span>
                                                    <br />
                                                </h6>
                                                <div
                                                    class="container justify-content-around"
                                                >
                                                    <a
                                                        t-foreach="object.tag_ids"
                                                        t-as="company_tag"
                                                        t-attf-href="/projects?tags={{company_tag.id}}"
                                                    >
                                                        <span
                                                            class="s_badge badge text-bg-secondary o_animable bg-o-color-1"
                                                            t-out="company_tag.name"
                                                        />
                                                    </a>
                                                </div>
                                                <h6>
                                                    <div
                                                        class="s_social_media text-start o_not_editable"
                                                        data-snippet="s_social_media"
                                                    >
                                                        <h4
                                                            class="s_social_media_title o_default_snippet_text d-none"
                                                        >
                                                            Social Networks
                                                        </h4>
                                                        <a
                                                            t-if="object.social_twitter"
                                                            t-att-href="object.social_twitter"
                                                            class="s_social_media_twitter"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-twitter shadow-sm text-o-color-1 bg-o-color-3 m-1"
                                                            />
                                                        </a>
                                                        <a
                                                            t-if="object.social_facebook"
                                                            t-att-href="object.social_facebook"
                                                            class="s_social_media_facebook"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-facebook shadow-sm text-o-color-1 bg-o-color-3 m-1"
                                                            />
                                                        </a>
                                                        <a
                                                            t-if="object.social_instagram"
                                                            t-att-href="object.social_instagram"
                                                            class="s_social_media_instagram"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-instagram shadow-sm text-o-color-1 bg-o-color-3 m-1"
                                                            />
                                                        </a>
                                                        <a
                                                            t-if="object.social_youtube"
                                                            t-att-href="object.social_youtube"
                                                            class="s_social_media_youtube"
                                                            target="_blank"
                                                        >
                                                            <i
                                                                class="fa fa-youtube shadow-sm text-o-color-1 bg-o-color-3 m-1"
                                                            />
                                                        </a>
                                                    </div>
                                                </h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </section>
                <section
                    class="s_text_block o_colored_level pt0 pb0 o_cc o_cc4"
                    style="background-image: none;"
                >
                    <div class="s_allow_columns container-fluid">
                        <div class="row" style="">
                            <div
                                class="o_colored_level col-lg-12 o_cc o_cc2"
                                style="text-align: center;"
                            >
                                <span class="s_badge badge o_animable bg-white-25">
                                    <a href="#about">
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            about
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge o_animable bg-white-25"
                                    t-if="blog_posts"
                                >
                                    <a href="#updates">
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            updates
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge o_animable bg-white-25"
                                    t-if="events"
                                >
                                    <a href="#events">
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            events
                                        </span>
                                    </a>
                                </span>
                                <span class="s_badge badge o_animable bg-white-25">
                                    <a href="#donation">
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            donation
                                        </span>
                                    </a>
                                </span>
                                <span
                                    class="s_badge badge text-bg-secondary o_animable bg-white-25"
                                >
                                    <a href="#contact">
                                        <span
                                            style="font-size: 18px; font-weight: normal;"
                                        >
                                            contact
                                        </span>
                                    </a>
                                </span>
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_text_block pt40 o_colored_level pb40"
                    style="background-image: none;"
                    id="about"
                >
                    <div class="container">
                        <div class="row">
                            <div class="o_colored_level pb40 pt40 col-lg-6 o_cc">
                                <h5 t-out="object.website_description" />
                                <br />
                                <p>
                                    <span
                                        t-if="object.bankayma_inception_year"
                                        style=""
                                    >
                                        <strong>Since:&amp;nbsp;&amp;nbsp;</strong>
                                        <t t-out="object.bankayma_inception_year" />
                                    </span>
                                    <br />
                                </p>
                                <div
                                    id="team"
                                    t-if="object.bankayma_website_crew_partner_ids"
                                >
                                    <p>
                                        <strong>Our crew:&amp;nbsp;&amp;nbsp;</strong>
                                        <span
                                            t-foreach="object.bankayma_website_crew_partner_ids"
                                            t-as="partner"
                                        >
                                                <!-- prettier-ignore-start -->
                                                <t t-out="partner.name" /><span t-if="partner.function">, </span><t t-out="partner.function" />
                                                <!-- prettier-ignore-end -->
                                            </span>
                                        <br />
                                    </p>
                                </div>
                                <div
                                    id="backers"
                                    t-if="object.bankayma_website_backer_partner_ids"
                                >
                                    <p>
                                        <strong
                                        >Our backers:&amp;nbsp;&amp;nbsp;</strong>
                                        <span
                                            t-foreach="object.bankayma_website_backer_partner_ids"
                                            t-as="partner"
                                        >
                                                <!-- prettier-ignore-start -->
                                                <t t-out="partner.name" /><span t-if="partner.function">, </span><t t-out="partner.function" />
                                                <!-- prettier-ignore-end -->
                                            </span>
                                        <br />
                                    </p>
                                </div>
                                <p>
                                    <span t-if="object.website" style="">
                                        <strong>Website:&amp;nbsp;&amp;nbsp;</strong>
                                        <a t-att-href="object.website">
                                            <t t-out="object.website" />
                                        </a>
                                    </span>
                                    <br />
                                </p>
                            </div>
                            <div
                                class="mx-auto media_iframe_video pb40 pt40 col-lg-6 o_cc"
                                t-if="object.bankayma_website_videolink_embed"
                            >
                                <div class="media_iframe_video_size" />
                                <iframe
                                    t-att-src="object.bankayma_website_videolink_embed"
                                    frameborder="0"
                                    allowfullscreen="allowfullscreen"
                                    marginheight="0"
                                    marginwidth="0"
                                />
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_blog_posts s_dynamic o_colored_level pb40 pt40 o_cc o_cc1 s_blog_post_card"
                    id="updates"
                    t-if="blog_posts"
                >
                    <div class="container s_blog_post_card">
                        <div
                            class="s_hr text-start pt32 pb32"
                            data-snippet="s_hr"
                            data-name="seperator"
                        >
                            <hr
                                class="w-100 mx-auto"
                                style="border-top: 1px solid rgb(130, 109, 140);"
                            />
                        </div>
                        <h2 style="text-align: center;">
                            <strong>updates</strong>
                        </h2>
                        <t
                            t-out="render_dynamic_snippet('website_blog.dynamic_filter_template_blog_post_card', blog_posts, col=4)"
                        />
                    </div>
                </section>
                <section id="events" t-if="events">
                    <div class="container s_allow_columns s_dynamic s_event_event_card">
                        <div
                            class="s_hr text-start pt32 pb32"
                            data-snippet="s_hr"
                            data-name="seperator"
                        >
                            <hr
                                class="w-100 mx-auto"
                                style="border-top: 1px solid rgb(130, 109, 140);"
                            />
                        </div>
                        <h2 style="text-align: center;">
                            <strong>events</strong>
                        </h2>
                        <t
                            t-out="render_dynamic_snippet('website_event.dynamic_filter_template_event_event_card', events)"
                        />
                        <a t-attf-href="/events?projects=[{{object.id}}]">Read more</a>
                    </div>
                </section>
                <section
                    class="pt40 pb40 o_colored_level o_cc o_cc1"
                    style="background-image: none;"
                    id="donation"
                    data-anchor="true"
                    dir="ltr"
                >
                    <div class="container">
                        <div
                            class="s_hr text-start pt32 pb32"
                            data-snippet="s_hr"
                            data-name="seperator"
                        >
                            <hr
                                class="w-100 mx-auto"
                                style="border-top: 1px solid rgb(130, 109, 140);"
                            />
                        </div>
                        <h2 style="text-align: center;">
                            <strong>donation</strong>
                        </h2>
                        <div class="row align-items-center">
                            <div class="o_colored_level col-lg-6 o_cc o_cc1 pt0 pb0">
                                <h2 style="text-align: center;">
                                    <strong>תרומה חד פעמית</strong>
                                </h2>
                                <div
                                    class="s_donation"
                                    data-name="Donation Button"
                                    t-att-data-donation-email="object.email"
                                    data-custom-amount="freeAmount"
                                    data-prefilled-options="true"
                                    data-descriptions=""
                                    data-minimum-amount="30"
                                    data-maximum-amount="360"
                                    data-slider-step="10"
                                    data-default-amount="50"
                                    data-snippet="s_donation_button"
                                    data-display-options="true"
                                    data-recurrent-payment=""
                                    data-donation-amounts="[&quot;100&quot;,&quot;200&quot;,&quot;500&quot;]"
                                >
                                    <form
                                        class="s_donation_form"
                                        t-attf-action="/donation/pay?company_id={{object.id}}"
                                        method="post"
                                        enctype="multipart/form-data"
                                        style="text-align: center;"
                                    >
                                        <span id="s_donation_description_inputs" />
                                        <div class="s_donation_prefilled_buttons mb-2">
                                            <button
                                                class="s_donation_btn btn btn-outline-primary btn-lg mb-2 me-1 o_not_editable"
                                                type="button"
                                                data-donation-value="100"
                                                contenteditable="false"
                                            >
                                                100
                                            </button>
                                            <button
                                                class="s_donation_btn btn btn-outline-primary btn-lg mb-2 me-1 o_not_editable"
                                                type="button"
                                                data-donation-value="200"
                                                contenteditable="false"
                                            >
                                                200
                                            </button>
                                            <button
                                                class="s_donation_btn btn btn-outline-primary btn-lg mb-2 me-1 o_not_editable"
                                                type="button"
                                                data-donation-value="500"
                                                contenteditable="false"
                                            >
                                                500
                                            </button>
                                            <span
                                                class="s_donation_btn s_donation_custom_btn btn btn-outline-primary btn-lg mb-2 me-1"
                                            >
                                                <input
                                                    id="s_donation_amount_input"
                                                    type="number"
                                                    min="30"
                                                    placeholder="כמות מותאמת אישית"
                                                    aria-label="סכום כולל"
                                                    style=""
                                                />
                                            </span>
                                        </div>
                                        <a
                                            href="#"
                                            type="button"
                                            class="s_donation_donate_btn btn btn-secondary btn-lg mb-2"
                                            data-bs-original-title=""
                                            title=""
                                        >
                                            Donate
                                        </a>
                                    </form>
                                </div>
                            </div>
                            <div class="o_colored_level col-lg-6 o_cc o_cc1">
                                <h2 style="text-align: center;">
                                    <strong>Monthly Support</strong>
                                    <br />
                                </h2>
                                <div
                                    class="s_donation"
                                    data-name="Donation Button"
                                    t-att-data-donation-email="object.email"
                                    data-custom-amount="freeAmount"
                                    data-prefilled-options="true"
                                    data-descriptions=""
                                    data-minimum-amount="30"
                                    data-maximum-amount="360"
                                    data-slider-step="10"
                                    data-default-amount="50"
                                    data-snippet="s_donation_button"
                                    data-display-options="true"
                                    data-recurrent-payment="true"
                                    data-donation-amounts="[&quot;30&quot;,&quot;50&quot;,&quot;100&quot;]"
                                >
                                    <form
                                        class="s_donation_form"
                                        t-attf-action="/donation/pay?company_id={{object.id}}"
                                        method="post"
                                        enctype="multipart/form-data"
                                        style="text-align: center;"
                                    >
                                        <span id="s_donation_description_inputs" />
                                        <div class="s_donation_prefilled_buttons mb-2">
                                            <button
                                                class="s_donation_btn btn btn-outline-primary btn-lg mb-2 me-1 o_not_editable"
                                                type="button"
                                                data-donation-value="30"
                                                contenteditable="false"
                                            >
                                                30
                                            </button>
                                            <button
                                                class="s_donation_btn btn btn-outline-primary btn-lg mb-2 me-1 o_not_editable"
                                                type="button"
                                                data-donation-value="50"
                                                contenteditable="false"
                                            >
                                                50
                                            </button>
                                            <button
                                                class="s_donation_btn btn btn-outline-primary btn-lg mb-2 me-1 o_not_editable"
                                                type="button"
                                                data-donation-value="100"
                                                contenteditable="false"
                                            >
                                                100
                                            </button>
                                            <span
                                                class="s_donation_btn s_donation_custom_btn btn btn-outline-primary btn-lg mb-2 me-1"
                                            >
                                                <input
                                                    id="s_donation_amount_input"
                                                    type="number"
                                                    min="30"
                                                    placeholder="כמות מותאמת אישית"
                                                    aria-label="סכום כולל"
                                                    style=""
                                                />
                                            </span>
                                        </div>
                                        <a
                                            href="#"
                                            type="button"
                                            class="s_donation_donate_btn btn btn-secondary btn-lg mb-2"
                                            data-bs-original-title=""
                                            title=""
                                        >
                                            לתרומה
                                        </a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section
                    class="s_image_gallery pt24 o_colored_level o_slideshow s_image_gallery_indicators_arrows_boxed s_image_gallery_show_indicators s_image_gallery_indicators_dots o_cc o_cc4"
                    data-vcss="001"
                    data-columns="3"
                    style="overflow: hidden; height: 662px; background-image: none;"
                    data-snippet="s_image_gallery"
                    data-name="Image Gallery"
                    t-if="object.bankayma_website_image_ids"
                >
                    <div class="container">
                        <div
                            id="slideshow_1725973766980"
                            class="carousel slide"
                            data-bs-ride="carousel"
                            data-bs-interval="0"
                            style="margin: 0 12px;"
                        >
                            <div class="carousel-inner" style="padding: 0;">
                                <div
                                    t-attf-class="carousel-item {{'active' if image_index == 0 else ''}}"
                                    style=""
                                    t-foreach="object.bankayma_website_image_ids"
                                    t-as="image"
                                >
                                    <img
                                        t-att-src="image_data_uri(image.datas)"
                                        alt=""
                                        class="img img-fluid d-block o_we_custom_image shadow"
                                        loading="lazy"
                                        style=""
                                        t-attf-data-index="{{image_index}}"
                                    />
                                </div>
                            </div>

                            <ul class="carousel-indicators" style="">
                                <li
                                    class="o_indicators_left text-center d-none"
                                    aria-label="קודם"
                                    title="קודם"
                                >
                                    <i class="fa fa-chevron-left" />
                                </li>

                                <li
                                    t-foreach="object.bankayma_website_image_ids"
                                    t-as="image"
                                    data-bs-target="#slideshow_1725973766980"
                                    t-attf-data-bs-slide-to="{{image_index}}"
                                    t-attf-style="background-image: url({{image_data_uri(image.datas)}})"
                                    t-att-aria-current="'true' if image_index == 0 else None"
                                    t-att-class="'active' if image_index == 0 else None"
                                />
                                <li
                                    class="o_indicators_right text-center d-none"
                                    aria-label="הבא"
                                    title="הבא"
                                >
                                    <i class="fa fa-chevron-right" />
                                </li>
                            </ul>
                            <a
                                class="carousel-control-prev o_we_no_overlay o_not_editable"
                                href="#slideshow_1725973766980"
                                data-bs-slide="prev"
                                aria-label="קודם"
                                title="קודם"
                            >
                                <span class="fa fa-chevron-left fa-2x text-white" />
                                <span class="visually-hidden">קודם</span>
                            </a>
                            <a
                                class="carousel-control-next o_we_no_overlay o_not_editable"
                                href="#slideshow_1725973766980"
                                data-bs-slide="next"
                                aria-label="הבא"
                                title="הבא"
                            >
                                <span class="fa fa-chevron-right fa-2x text-white" />
                                <span class="visually-hidden">הבא</span>
                            </a>
                        </div>
                    </div>
                </section>
                <section
                    class="s_text_block o_colored_level pb16 pt16 o_cc o_cc1"
                    style="background-image: none;"
                    id="contact"
                >
                    <div class="s_allow_columns o_container_small">
                        <h4 class="text-center mb-1" style="">
                            <span style="font-size: 16px;">
                                <a title="" data-bs-original-title="" href="/about">
                                    <span style="font-size: 16px;" />
                                </a>
                            </span>
                            <span
                                style="font-size: 18px;"
                            >&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;
                                <strong
                                    t-field="object.partner_id"
                                    t-options='{"widget": "contact"}'
                                />
                            </span>
                        </h4>
                        <h4
                            class="text-center mb-1"
                            style="text-align: right;"
                            t-if="object.bankayma_website_opening_hours"
                        >
                            <span t-field="object.bankayma_website_opening_hours" />
                        </h4>
                        <h4 class="text-center mb-1" style="text-align: right;">
                            <span style="font-size: 16px;">
                                <strong t-out="object.phone" />
                            </span>
                            <span style="font-size: 16px;">
                                <a t-att-href="object.website" t-out="object.website" />
                            </span>
                            <span style="font-size: 16px;">
                                <a t-att-href="object.email" t-out="object.email" />
                            </span>
                        </h4>
                    </div>
                </section>
                <section id="footer" class="d-flex">
                    <div class="container mb-2 d-flex">
                        <div
                            class="d-flex flex-grow-1 text-start flex-row"
                            t-if="prev_object != object"
                        >
