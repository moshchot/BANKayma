<odoo>
    <template id="record_cover" inherit_id="website.record_cover">
        <div t-if="use_filters" position="after">
            <t
                t-set="company_logo"
                t-value="'company_id' in _record._fields and _record.company_id.with_context(bin_size=False).logo"
            />
            <img
                t-if="company_logo"
                t-att-src="image_data_uri(company_logo)"
                class="bk-company-logo-overlay"
            />
        </div>
    </template>
    <template id="website_layout" inherit_id="website.layout">
        <t t-if="editable or translatable" position="after">
            <t
                t-set="nothing"
                t-value="html_data.update({'data-bankayma_editable': '1' if bankayma_editable else '0'})"
            />
        </t>
    </template>
</odoo>
