    </template>
    <template
        id="event_description_full"
        inherit_id="website_event.event_description_full"
        priority="100"
    >
        <div t-field="event.organizer_id" position="before">
            <a
                t-att-href="event.sudo().operating_unit_id.website_link"
                t-if="event.sudo().operating_unit_id.logo"
                style="float: right"
            >
                <img
                    t-att-src="image_data_uri(event.sudo().operating_unit_id.logo)"
                    style="width: 5rem"
                />
            </a>
        </div>
        <!-- remove country from contact widget -->
        <xpath expr="//small[@t-field='event.address_id']" position="attributes">
            <attribute name="t-options" operation="update">
                {'bankayma_address_suppress_il': True}
            </attribute>
        </xpath>
        <!-- remove contact details from event page -->
        <xpath
            expr="//small[@t-field='event.address_id'][contains(@t-options, 'phone')]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <!-- remove sharing section -->
        <xpath
            expr="//t[@t-snippet-call='website.s_share']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
    <template
        id="registration_complete"
        inherit_id="website_event.registration_complete"
    >
        <!-- remove country from contact widget -->
        <xpath expr="//a[@t-field='event.address_id']" position="attributes">
            <attribute name="t-options" operation="update">
                {'bankayma_address_suppress_il': True}
            </attribute>
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_event_event_card"
        inherit_id="website_event.dynamic_filter_template_event_event_card"
        priority="100"
    >
        <!-- remove country -->
        <xpath expr="//div[@t-field='record.address_id']" position="attributes">
            <attribute name="t-options" operation="update">
                {'bankayma_address_suppress_il': True}
            </attribute>
        </xpath>
    </template>
    <template
        id="registration_attendee_details"
        inherit_id="website_event.registration_attendee_details"
    >
        <xpath expr="//div[hasclass('modal-lg')]" position="attributes">
            <attribute name="class" add="modal-xl" separator=" " />
            <attribute name="class" remove="modal-lg" separator=" " />
        </xpath>
    </template>
</odoo>
