<odoo>
    <template id="index_topbar" inherit_id="website_event.index_topbar">
        <xpath expr="//div[hasclass('o_wevent_index_topbar_filters')]/.." position="attributes">
            <attribute
                name="class"
                separator=" "
                add="bankayma_event_searchbar sticky-top pt16 pb16 o_cc o_cc4"
            />
        </xpath>
        <xpath expr="//div[hasclass('o_wevent_index_topbar_filters')]/t" position="after">
            <div class="dropdown d-none d-lg-block">
                <a
                    href="#"
                    role="button"
                    class="btn btn-light dropdown-toggle"
                    data-bs-toggle="dropdown"
                >
                    <t>Project</t>
                    <span t-if="ous_selected" t-out="len(ous_selected)" class="badge bg-primary ms-1" />
                </a>
                <div class="dropdown-menu">
                    <span
                        t-att-data-post="'/event?%s' % keep_query('*', projects=None)"
                        t-attf-class="post_link cursor-pointer dropdown-item d-flex align-items-center justify-content-between #{'active' if not ous_selected.ids else ''}"
                    >
                        All
                    </span>
                    <t t-foreach="ous_available" t-as="operating_unit">
                        <span
                            t-att-data-post="'/event?%s' % keep_query('*', projects=str(((operating_unit | ous_selected) if operating_unit.id not in ous_selected.ids else (ous_selected - operating_unit)).ids))"
                            t-attf-class="post_link cursor-pointer dropdown-item d-flex align-items-center justify-content-between #{'active' if operating_unit.id in ous_selected.ids else ''}"
                        >
                            <t t-out="operating_unit.name" />
                        </span>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
    <template id="searched_tags" inherit_id="website_event.searched_tags">
        <div position="after">
            <div class="d-flex align-items-center mt16">
                <t t-foreach="ous_selected" t-as="operating_unit">
                    <span
                        t-attf-class="align-items-baseline border d-inline-flex ps-2 rounded ml16 mb-2"
                    >
                        <i class="fa fa-tag me-2 text-muted" />
                        <t t-out="operating_unit.name" />
                        <a
                            t-att-href="'/event?%s' % keep_query('*', projects=str((ous_selected - operating_unit).ids))"
                            class="btn border-0 py-1"
                        >&#215;</a>
                    </span>
                </t>
            </div>
        </div>
    </template>
    <template id="events_list" inherit_id="website_event.events_list" priority="100">
        <!-- don't show location/city, show organizer name instead -->
        <xpath expr="//div[@t-if='not event.address_id or has_city_or_country']" position="before">
            <t name="deactivate location" t-if="False" />
        </xpath>
        <t name="deactivate location" position="inside">
            <xpath expr="//div[@t-if='not event.address_id or has_city_or_country']" position="move" />
        </t>
        <t name="deactivate location" position="after">
            <div class="d-flex align-items-center" itemprop="organizer" t-out="event.sudo().address_id.name" />
        </t>
    </template>
