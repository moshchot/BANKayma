<odoo>
    <template id="index_topbar" inherit_id="website_event.index_topbar">
        <nav position="attributes">
            <attribute
                name="class"
                separator=" "
                add="bankayma_event_searchbar sticky-top pt16 pb16 o_cc o_cc4"
            />
        </nav>
        <xpath expr="//ul[hasclass('o_wevent_index_topbar_filters')]" position="inside">
            <li class="nav-item dropdown me-2 my-1">
                <a
                    href="#"
                    role="button"
                    class="btn dropdown-toggle"
                    data-bs-toggle="dropdown"
                >
                    <i class="fa fa-folder-open" />
                    Project
                </a>
                <div class="dropdown-menu">
                    <t t-foreach="companies_available" t-as="company">
                        <a
                            t-att-href="'/event?%s' % keep_query('*', projects=str(((company | companies_selected) if company.id not in companies_selected.ids else (companies_selected - company)).ids))"
                            t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if company.id in companies_selected.ids else ''}"
                        >
                            <t t-out="company.name" />
                        </a>
                    </t>
                </div>
            </li>
        </xpath>
    </template>
    <template id="searched_tags" inherit_id="website_event.searched_tags">
        <div position="after">
            <div class="d-flex align-items-center mt16">
                <t t-foreach="companies_selected" t-as="company">
                    <span
                        t-attf-class="align-items-baseline border d-inline-flex ps-2 rounded ml16 mb-2"
                    >
                        <i class="fa fa-tag me-2 text-muted" />
                        <t t-out="company.name" />
                        <a
                            t-att-href="'/event?%s' % keep_query('*', projects=str((companies_selected - company).ids))"
                            class="btn border-0 py-1"
                        >&#215;</a>
                    </span>
                </t>
            </div>
        </div>
    </template>
    <template id="events_list" inherit_id="website_event.events_list">
        <div itemprop="location" position="attributes">
            <attribute name="t-if">False</attribute>
        </div>
        <div itemprop="location" position="after">
            <div itemprop="organizer" t-out="event.sudo().address_id.name" />
        </div>
        <wraptext
            expr="(//span[@t-out='event.date_tz'])[1]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[1]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext expr="(//span[@t-out='event.date_tz'])[1]" position="tail" />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[1]/following-sibling::t"
            position="replace"
        />
        <xpath expr="(//span[@t-out='event.date_tz'])[1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
    <template id="layout" inherit_id="website_event.layout">
        <a href="/event" position="after">
            <i class="fa fa-chevron-right me-2" />
            <a
                t-attf-href="{{event.sudo().company_id.website_link}}#events"
                class="navbar-brand h4 my-0 me-0 me-md-4"
                t-out="event.company_id.name"
            />
        </a>
        <xpath
            expr="//a[@href='/event']//i[hasclass('fa-long-arrow-left')]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//li[@t-if='event.country_id']" position="after">
            <li t-if="event.sudo().address_id.city" class="nav-item me-3">
                <a
                    t-attf-href="/event?city=#{event.sudo().address_id.city}"
                    class="nav-link"
                >
                    <i class="fa fa-map-marker me-2" />
                    <span t-field="event.sudo().address_id.city" />
                </a>
            </li>
        </xpath>
        <xpath expr="//li[@t-if='event.country_id']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//li[@t-if='opt_events_list_categories']" position="attributes">
            <attribute name="t-if" add="and event.event_type_id" separator=" " />
        </xpath>
    </template>
    <template
        id="event_description_full"
        inherit_id="website_event.event_description_full"
    >
        <h4 t-field="event.organizer_id" position="before">
            <a
                t-att-href="event.sudo().company_id.website_link"
                t-if="event.company_id.logo"
                style="float: right"
            >
                <img
                    t-att-src="image_data_uri(event.company_id.logo)"
                    style="width: 5rem"
                />
            </a>
        </h4>
        <!-- remove time zone after dates and their enclosing brackets -->
        <wraptext expr="(//span[@t-out='event.date_tz'])[1]/.." position="text" />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[1]/preceding-sibling::t"
            position="replace"
        />
        <wraptext expr="(//span[@t-out='event.date_tz'])[1]" position="tail" />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[1]/following-sibling::t"
            position="replace"
        />
        <xpath expr="(//span[@t-out='event.date_tz'])[1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <wraptext
            expr="(//span[@t-out='event.date_tz'])[2]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[2]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext expr="(//span[@t-out='event.date_tz'])[2]" position="tail" />
        <xpath
            expr="(//span[@t-out='event.date_tz'])[2]/following-sibling::t"
            position="replace"
        />
        <xpath expr="(//span[@t-out='event.date_tz'])[2]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <!-- remove country from contact widget -->
        <xpath expr="//div[@itemprop='location']" position="attributes">
            <attribute name="t-options" operation="update">
                {'bankayma_address_suppress_il': True}
            </attribute>
        </xpath>
        <!-- remove contact details from event page -->
        <xpath
            expr="//div[@t-field='event.address_id'][hasclass('mb-3')]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
    <template
        id="registration_complete"
        inherit_id="website_event.registration_complete"
    >
        <!-- remove country from contact widget -->
        <xpath expr="//a[@itemprop='location']" position="attributes">
            <attribute name="t-options" operation="update">
                {'bankayma_address_suppress_il': True}
            </attribute>
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_event_event_card"
        inherit_id="website_event.dynamic_filter_template_event_event_card"
    >
        <!-- remove time zone after dates and their enclosing brackets -->
        <wraptext
            expr="(//span[@t-out='record.date_tz'])[1]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='record.date_tz'])[1]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext expr="(//span[@t-out='record.date_tz'])[1]" position="tail" />
        <xpath
            expr="(//span[@t-out='record.date_tz'])[1]/following-sibling::t"
            position="replace"
        />
        <xpath expr="(//span[@t-out='record.date_tz'])[1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <!-- remove country -->
        <xpath expr="//div[@t-field='record.address_id']" position="attributes">
            <attribute name="t-options" operation="update">
                {'bankayma_address_suppress_il': True}
            </attribute>
        </xpath>
    </template>
    <template
        id="dynamic_filter_template_event_event_picture"
        inherit_id="website_event.dynamic_filter_template_event_event_picture"
    >
        <!-- remove time zone after dates and their enclosing brackets -->
        <wraptext
            expr="(//span[@t-out='record.date_tz'])[1]/preceding-sibling::span[1]"
            position="tail"
        />
        <xpath
            expr="(//span[@t-out='record.date_tz'])[1]/preceding-sibling::t[1]"
            position="replace"
        />
        <wraptext expr="(//span[@t-out='record.date_tz'])[1]" position="tail" />
        <xpath
            expr="(//span[@t-out='record.date_tz'])[1]/following-sibling::t"
            position="replace"
        />
        <xpath expr="(//span[@t-out='record.date_tz'])[1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
    <template
        id="registration_attendee_details"
        inherit_id="website_event.registration_attendee_details"
    >
        <xpath expr="//div[hasclass('modal-lg')]" position="attributes">
            <attribute name="class" add="modal-xl" separator=" " />
            <attribute name="class" remove="modal-lg" separator=" " />
        </xpath>
    </template>
</odoo>
