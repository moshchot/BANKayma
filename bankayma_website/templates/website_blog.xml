<odoo>
    <template
        id="opt_blog_post_comment"
        inherit_id="website_blog.opt_blog_post_comment"
    >
        <a
            t-attf-href="/web/login?redirect=/blog/{{slug(blog_post.blog_id)}}/{{slug(blog_post)}}#discussion"
            position="attributes"
        >
            <attribute name="t-attf-href">
                /web/login?redirect={{blog_post.website_url}}#discussion
            </attribute>
        </a>
    </template>
    <template
        id="opt_blog_post_read_next"
        inherit_id="website_blog.opt_blog_post_read_next"
    >
        <a
            t-att-href="'/blog/' + slug(next_post.blog_id) + '/' + slug(next_post)"
            position="attributes"
        >
            <attribute name="t-att-href">next_post.website_url</attribute>
        </a>
        <a
            t-att-href="'/blog/' + slug(next_post.blog_id) + '/' + slug(next_post)"
            position="attributes"
        >
            <attribute name="t-att-href">next_post.website_url</attribute>
        </a>
        <a
            t-att-data-url="'/blog/' + slug(next_post.blog_id) + '/' + slug(next_post) + '?anim'"
            position="attributes"
        >
            <attribute name="t-att-data-url">next_post.website_url + '?anim'</attribute>
        </a>
    </template>
    <template id="posts_loop" inherit_id="website_blog.posts_loop">
        <a
            t-attf-href="/blog/#{slug(blog_post.blog_id)}/#{slug(blog_post)}"
            position="attributes"
        >
            <attribute name="t-attf-href">{{blog_post.website_url}}</attribute>
        </a>
    </template>
    <template id="post_heading" inherit_id="website_blog.post_heading">
        <a
            t-attf-href="/blog/#{slug(blog_post.blog_id)}/#{slug(blog_post)}"
            position="attributes"
        >
            <attribute name="t-attf-href">{{blog_post.website_url}}</attribute>
        </a>
    </template>
    <template id="post_cover_image" inherit_id="website_blog.post_cover_image">
        <a
            t-attf-href="/blog/#{slug(blog_post.blog_id)}/#{slug(blog_post)}"
            position="attributes"
        >
            <attribute name="t-attf-href">{{blog_post.website_url}}</attribute>
        </a>
    </template>
    <template id="post_teaser" inherit_id="website_blog.post_teaser">
        <a
            t-attf-href="/blog/#{slug(blog_post.blog_id)}/#{slug(blog_post)}"
            position="attributes"
        >
            <attribute name="t-attf-href">{{blog_post.website_url}}</attribute>
        </a>
    </template>
    <template
        id="dynamic_filter_template_blog_post_card"
        inherit_id="website_blog.dynamic_filter_template_blog_post_card"
    >
        <h5 position="after">
            <h6 class="mb-0" t-field="record.subtitle" />
        </h5>
        <xpath expr="//span/a[contains(@t-att-href, '/blog')]/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span/a[contains(@t-att-href, '/blog')]/.." position="after">
            <div
                class="o_wblog_post_short_tag_section d-flex align-items-center flex-wrap"
                t-if="record.tag_ids"
            >
                <t t-foreach="record.tag_ids" t-as="tag">
                    <a
                        class="badge text-primary border me-1 post_link"
                        t-attf-href="/news/tag/#{slug(tag)}"
                        t-esc="tag.name"
                    />
                </t>
            </div>
        </xpath>
    </template>
</odoo>
