<odoo>
    <template id="company_page_embed" primary="True" inherit_id="company_page">
        <xpath expr="//ol[hasclass('breadcrumb')]" position="replace" />
        <xpath expr="//section[//img[@t-if='object.logo']]" position="replace" />
        <xpath expr="//section[//a[@href='#about']]" position="replace" />
        <xpath expr="//section[@id='about']" position="attributes">
            <attribute name="t-if">show_about</attribute>
        </xpath>
        <xpath expr="//section[@id='updates']" position="attributes">
            <attribute name="t-if">show_updates</attribute>
        </xpath>
        <xpath expr="//section[@id='events']" position="attributes">
            <attribute name="t-if">show_events</attribute>
        </xpath>
        <xpath expr="//section[@id='donation']" position="attributes">
            <attribute name="t-if">show_donation</attribute>
        </xpath>
        <xpath expr="//section[@id='gallery']" position="attributes">
            <attribute name="t-if">show_gallery</attribute>
        </xpath>
        <xpath expr="//section[@id='contact']" position="attributes">
            <attribute name="t-if">show_contact</attribute>
        </xpath>
    </template>
</odoo>
