<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="bankayma_website" string="Website settings">
                    <group>
                        <field name="website_link" widget="url" />
                        <field name="seo_name" required="True" />
                        <field name="bankayma_website_subtitle" />
                        <field name="bankayma_website_opening_hours" />
                        <field name="bankayma_website_geolink" widget="url" />
                        <field name="bankayma_website_videolink" widget="url" />
                        <field
                            name="bankayma_website_image_ids"
                            widget="many2many_binary"
                        />
                        <field
                            name="bankayma_website_crew_partner_ids"
                            widget="many2many_tags"
                            domain="[('user_ids.groups_id', 'in', [%(base.group_user)s, %(bankayma_base.group_vendor)s])]"
                            options="{'no_create': True}"
                        />
                        <field
                            name="bankayma_website_backer_partner_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                        />
                    </group>
                    <field
                        name="website_description"
                        placeholder="Website description"
                        required="True"
                    />
                </page>
            </notebook>
        </field>
    </record>
</odoo>
