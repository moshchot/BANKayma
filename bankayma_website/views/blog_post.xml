<odoo>
    <record id="view_blog_post_form" model="ir.ui.view">
        <field name="inherit_id" ref="website_blog.view_blog_post_form" />
        <field name="model">blog.post</field>
        <field name="arch" type="xml">
            <field name="website_id" position="before">
                <field name="company_id" />
            </field>
        </field>
    </record>
    <record id="blog_post_view_form_add" model="ir.ui.view">
        <field name="inherit_id" ref="website_blog.blog_post_view_form_add" />
        <field name="model">blog.post</field>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="cover_image" widget="image" />
            </field>
        </field>
    </record>
    <record id="website_blog.blog_post_action_add" model="ir.actions.act_window">
        <field
            name="context"
            eval="&quot;{'default_company_id': allowed_company_ids[0]}&quot;"
        />
    </record>
</odoo>
