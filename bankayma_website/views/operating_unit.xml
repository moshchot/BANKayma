<odoo>
    <record id="view_operating_unit_form" model="ir.ui.view">
        <field name="inherit_id" ref="operating_unit.view_operating_unit_form" />
        <field name="model">operating.unit</field>
        <field name="arch" type="xml">
            <form position="inside">
                <group name="bankayma_website" string="Website settings">
                    <group>
                        <field name="website_link" widget="url" />
                        <field name="seo_name" required="True" />
                        <field name="bankayma_website_subtitle" />
                        <field name="bankayma_inception_year" />
                        <field name="bankayma_website_opening_hours" />
                        <field name="bankayma_website_cover" widget="image" />
                        <field name="bankayma_website_videolink" widget="url" />
                        <field
                            name="bankayma_website_image_ids"
                            widget="many2many_binary"
                        />
                        <field
                            name="bankayma_website_crew_partner_ids"
                            widget="many2many_tags"
                            domain="[('user_ids.groups_id', 'in', [%(base.group_user)s, %(bankayma_base.group_vendor)s])]"
                            options="{'no_create': True}"
                        />
                        <field
                            name="bankayma_website_backer_partner_ids"
                            domain="[('parent_id', '=', False), ('is_company', '=', True)]"
                            widget="many2many_tags"
                        />
                    </group>
                    <field
                        name="website_description"
                        placeholder="Website description"
                        required="True"
                    />
                </group>
            </form>
        </field>
    </record>
</odoo>
