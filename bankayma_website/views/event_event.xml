<odoo>
    <record id="view_event_form" model="ir.ui.view">
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <page name="event_communication" position="attributes">
                <attribute name="groups">
                    bankayma_base.group_org_manager,bankayma_base.group_full
                </attribute>
            </page>
        </field>
    </record>
    <record id="event_external_form_inherit" model="ir.ui.view">
        <field name="model">event.event</field>
        <field
            name="inherit_id"
            ref="website_event_external.event_external_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="is_external" position="move" />
            </field>
        </field>
    </record>
</odoo>
